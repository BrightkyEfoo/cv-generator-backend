# ===========================================
# CV Generator Backend - Environment Variables
# ===========================================

# Application
NODE_ENV=development
PORT=3001

# ===========================================
# Database Configuration
# ===========================================
# For local development (without Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/cv_generator?schema=public"

# Docker PostgreSQL settings (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cv_generator
POSTGRES_PORT=5432

# ===========================================
# Stripe Payment Integration
# ===========================================
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===========================================
# CORS Configuration
# ===========================================
# Frontend URL for CORS (adjust for production)
FRONTEND_URL=http://localhost:3000

# ===========================================
# API Key (for frontend authentication)
# ===========================================
API_KEY=your-api-key-here

# ===========================================
# File Upload Configuration
# ===========================================
MAX_FILE_SIZE_MB=5

# ===========================================
# Admin Authentication
# ===========================================
# IMPORTANT: Change these values in production!
ADMIN_JWT_SECRET=your-super-secret-jwt-key-change-in-production
ADMIN_PASSWORD=admin123
