<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: {{typography.bodySize}}pt;
      line-height: {{typography.lineHeight}};
      color: {{colors.text}};
      background: {{colors.background}};
    }

    .cv-container {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 35%;
      background: #3d3d3d;
      color: #ffffff;
      padding: 0;
    }

    .main-content {
      width: 65%;
      padding: 40px;
      background: {{colors.background}};
    }

    .photo-container {
      padding: 40px;
      display: flex;
      justify-content: center;
    }

    .photo {
      width: 180px;
      height: 180px;
      border-radius: 50%;
      border: 5px solid {{colors.primary}};
      object-fit: cover;
      background: #666;
    }

    .sidebar-section {
      padding: 25px 30px;
    }

    .sidebar-section-title {
      font-size: 14pt;
      font-weight: 700;
      letter-spacing: 3px;
      margin-bottom: 20px;
      color: #ffffff;
      text-transform: uppercase;
    }

    .contact-item {
      margin-bottom: 15px;
    }

    .contact-label {
      font-weight: 700;
      font-size: 10pt;
      text-transform: uppercase;
      color: #ffffff;
      margin-bottom: 3px;
    }

    .contact-value {
      font-size: 10pt;
      color: #cccccc;
    }

    .skill-item {
      margin-bottom: 8px;
      font-size: 10pt;
      color: #cccccc;
      display: flex;
      align-items: center;
    }

    .skill-item::before {
      content: '';
      width: 6px;
      height: 6px;
      background: {{colors.primary}};
      border-radius: 50%;
      margin-right: 10px;
    }

    .reference-item {
      margin-bottom: 15px;
    }

    .reference-name {
      font-weight: 700;
      color: #ffffff;
      font-size: 11pt;
    }

    .reference-title {
      font-size: 9pt;
      color: #cccccc;
    }

    .reference-contact {
      font-size: 9pt;
      color: {{colors.primary}};
      margin-top: 5px;
    }

    .header {
      margin-bottom: 30px;
    }

    .name {
      font-size: 36pt;
      font-weight: 900;
      color: {{colors.headings}};
      text-transform: uppercase;
      line-height: 1.1;
      font-family: 'Georgia', serif;
    }

    .title {
      font-size: 12pt;
      letter-spacing: 5px;
      color: #666;
      text-transform: uppercase;
      margin-top: 10px;
    }

    .section {
      margin-bottom: 30px;
    }

    .section-title {
      font-size: 12pt;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: {{colors.primary}};
      border-bottom: 2px solid {{colors.primary}};
      padding-bottom: 8px;
      margin-bottom: 20px;
    }

    .education-item, .experience-item {
      margin-bottom: 20px;
    }

    .item-title {
      font-size: 12pt;
      font-weight: 700;
      color: {{colors.headings}};
    }

    .item-subtitle {
      font-size: 10pt;
      color: #666;
      margin-top: 2px;
    }

    .item-date {
      font-size: 9pt;
      color: {{colors.primary}};
      margin-top: 2px;
    }

    .item-description {
      font-size: 10pt;
      color: {{colors.text}};
      margin-top: 8px;
      text-align: justify;
    }

    .item-achievements {
      margin-top: 8px;
      padding-left: 15px;
    }

    .item-achievements li {
      font-size: 10pt;
      color: {{colors.text}};
      margin-bottom: 5px;
    }
  </style>
</head>
<body>
  <div class="cv-container">
    <div class="sidebar">
      @if(personalInfo.photoUrl)
      <div class="photo-container">
        <img src="{{personalInfo.photoUrl}}" alt="Photo" class="photo">
      </div>
      @endif

      <div class="sidebar-section">
        <h2 class="sidebar-section-title">Contact</h2>
        @if(personalInfo.address)
        <div class="contact-item">
          <div class="contact-label">Address:</div>
          <div class="contact-value">{{personalInfo.address}}, {{personalInfo.city}}, {{personalInfo.country}}</div>
        </div>
        @endif
        @if(personalInfo.email)
        <div class="contact-item">
          <div class="contact-label">Email:</div>
          <div class="contact-value">{{personalInfo.email}}</div>
        </div>
        @endif
        @if(personalInfo.phone)
        <div class="contact-item">
          <div class="contact-label">Phone:</div>
          <div class="contact-value">{{personalInfo.phone}}</div>
        </div>
        @endif
        @each(link in personalInfo.socialLinks)
        <div class="contact-item">
          <div class="contact-label">{{link.platform}}:</div>
          <div class="contact-value">{{link.label}}</div>
        </div>
        @endeach
      </div>

      <div class="sidebar-section">
        <h2 class="sidebar-section-title">Skills</h2>
        @each(skill in skills)
        <div class="skill-item">{{skill.name}}</div>
        @endeach
      </div>

      @if(languages.length)
      <div class="sidebar-section">
        <h2 class="sidebar-section-title">Languages</h2>
        @each(lang in languages)
        <div class="skill-item">{{lang.name}} - {{lang.proficiency}}</div>
        @endeach
      </div>
      @endif

      @if(certifications.length)
      <div class="sidebar-section">
        <h2 class="sidebar-section-title">Certifications</h2>
        @each(cert in certifications)
        <div class="contact-item">
          <div class="contact-label">{{cert.name}}</div>
          <div class="contact-value">{{cert.issuer}} - {{cert.issueDate}}</div>
        </div>
        @endeach
      </div>
      @endif

      @if(interests.length)
      <div class="sidebar-section">
        <h2 class="sidebar-section-title">Interests</h2>
        @each(interest in interests)
        <div class="skill-item">{{interest.name}}</div>
        @endeach
      </div>
      @endif

      @if(references.length)
      <div class="sidebar-section">
        <h2 class="sidebar-section-title">Reference</h2>
        @each(ref in references)
        <div class="reference-item">
          <div class="reference-name">{{ref.name}}</div>
          <div class="reference-title">{{ref.title}}, {{ref.company}}</div>
          <div class="reference-contact">{{ref.email}}</div>
        </div>
        @endeach
      </div>
      @endif
    </div>

    <div class="main-content">
      <div class="header">
        <h1 class="name">{{personalInfo.firstName}}<br>{{personalInfo.lastName}}</h1>
        <div class="title">{{personalInfo.title}}</div>
      </div>

      @if(summary)
      <div class="section">
        <h2 class="section-title">Profile</h2>
        <p class="item-description">{{summary}}</p>
      </div>
      @endif

      @if(objective)
      <div class="section">
        <h2 class="section-title">Objective</h2>
        <p class="item-description">{{objective}}</p>
      </div>
      @endif

      @if(education.length)
      <div class="section">
        <h2 class="section-title">Education</h2>
        @each(edu in education)
        <div class="education-item">
          <div class="item-title">{{edu.degree}} ({{edu.endDate}})</div>
          <div class="item-subtitle">{{edu.institution}}</div>
        </div>
        @endeach
      </div>
      @endif

      @if(experiences.length)
      <div class="section">
        <h2 class="section-title">Work Experience</h2>
        @each(exp in experiences)
        <div class="experience-item">
          <div class="item-title">{{exp.jobTitle}} at {{exp.company}}</div>
          <div class="item-date">{{exp.startDate}} - @if(exp.current)Current@else{{exp.endDate}}@endif</div>
          @if(exp.description)
          <p class="item-description">{{exp.description}}</p>
          @endif
          <ul class="item-achievements">
            @each(achievement in exp.achievements)
            <li>{{achievement}}</li>
            @endeach
          </ul>
        </div>
        @endeach
      </div>
      @endif

      @if(projects.length)
      <div class="section">
        <h2 class="section-title">Projects</h2>
        @each(project in projects)
        <div class="experience-item">
          <div class="item-title">{{project.name}}</div>
          @if(project.url)
          <div class="item-subtitle">{{project.url}}</div>
          @endif
          <p class="item-description">{{project.description}}</p>
          @if(project.technologies.length)
          <div class="item-subtitle">Technologies: {{project.technologies.join(', ')}}</div>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(publications.length)
      <div class="section">
        <h2 class="section-title">Publications</h2>
        @each(pub in publications)
        <div class="experience-item">
          <div class="item-title">{{pub.title}}</div>
          <div class="item-subtitle">{{pub.publisher}} - {{pub.publicationDate}}</div>
          @if(pub.description)
          <p class="item-description">{{pub.description}}</p>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(awards.length)
      <div class="section">
        <h2 class="section-title">Awards</h2>
        @each(award in awards)
        <div class="experience-item">
          <div class="item-title">{{award.title}}</div>
          <div class="item-subtitle">{{award.issuer}} - {{award.date}}</div>
          @if(award.description)
          <p class="item-description">{{award.description}}</p>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(volunteer.length)
      <div class="section">
        <h2 class="section-title">Volunteer Experience</h2>
        @each(vol in volunteer)
        <div class="experience-item">
          <div class="item-title">{{vol.role}} at {{vol.organization}}</div>
          <div class="item-date">{{vol.startDate}} - @if(vol.current)Current@else{{vol.endDate}}@endif</div>
          @if(vol.description)
          <p class="item-description">{{vol.description}}</p>
          @endif
        </div>
        @endeach
      </div>
      @endif
    </div>
  </div>
</body>
</html>
