<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: {{typography.bodySize}}pt;
      line-height: {{typography.lineHeight}};
      background: #2d2a5e;
      color: #ffffff;
      min-height: 100vh;
      padding: 40px;
    }

    .cv-container {
      max-width: 800px;
      margin: 0 auto;
    }

    .header-card {
      background: #3d3a7e;
      border: 2px solid #5a57a0;
      border-radius: 8px;
      padding: 25px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .name-block h1 {
      font-size: 24pt;
      font-weight: 700;
      color: #ffffff;
    }

    .title {
      font-size: 10pt;
      text-transform: uppercase;
      color: {{colors.primary}};
      letter-spacing: 2px;
      margin-top: 5px;
    }

    .photo {
      width: 80px;
      height: 80px;
      border-radius: 8px;
      object-fit: cover;
      background: #4a478a;
    }

    .cursor-icon {
      font-size: 30pt;
      color: {{colors.primary}};
    }

    .summary-card {
      background: #3d3a7e;
      border: 2px solid #5a57a0;
      border-radius: 8px;
      padding: 20px 25px;
      margin-bottom: 25px;
    }

    .summary-text {
      font-size: 10pt;
      color: #ccccdd;
      line-height: 1.6;
    }

    .content-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
      margin-bottom: 25px;
    }

    .card {
      background: #3d3a7e;
      border: 2px solid #5a57a0;
      border-radius: 8px;
      padding: 25px;
    }

    .card-title {
      font-size: 12pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #ffffff;
      margin-bottom: 20px;
    }

    .skill-category {
      margin-bottom: 15px;
    }

    .skill-category-name {
      font-size: 10pt;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 8px;
    }

    .skill-dots {
      display: flex;
      gap: 5px;
    }

    .skill-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: {{colors.primary}};
    }

    .skill-dot.empty {
      background: #5a57a0;
    }

    .experience-item {
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 1px solid #5a57a0;
    }

    .experience-item:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .exp-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
    }

    .exp-date {
      font-size: 9pt;
      font-weight: 700;
      color: {{colors.primary}};
    }

    .exp-title {
      font-size: 11pt;
      font-weight: 700;
      color: #ffffff;
    }

    .exp-company {
      font-size: 9pt;
      color: #aaaacc;
    }

    .exp-desc {
      font-size: 9pt;
      color: #ccccdd;
      margin-top: 8px;
      line-height: 1.5;
    }

    .exp-achievements {
      margin-top: 8px;
      padding-left: 15px;
    }

    .exp-achievements li {
      font-size: 9pt;
      color: #ccccdd;
      margin-bottom: 4px;
    }

    .bottom-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
      margin-bottom: 25px;
    }

    .cert-item {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
      font-size: 9pt;
      color: #ccccdd;
    }

    .cert-item::before {
      content: '';
      width: 6px;
      height: 6px;
      background: {{colors.primary}};
      border-radius: 50%;
      margin-right: 10px;
    }

    .edu-item {
      margin-bottom: 15px;
    }

    .edu-date {
      font-size: 9pt;
      font-weight: 700;
      color: {{colors.primary}};
    }

    .edu-degree {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .edu-school {
      font-size: 9pt;
      color: #aaaacc;
    }

    .lang-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 9pt;
      color: #ccccdd;
    }

    .lang-level {
      color: {{colors.primary}};
    }

    .project-item {
      margin-bottom: 15px;
      padding-bottom: 12px;
      border-bottom: 1px solid #5a57a0;
    }

    .project-item:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .project-name {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .project-url {
      font-size: 8pt;
      color: {{colors.primary}};
      margin-top: 3px;
    }

    .project-desc {
      font-size: 9pt;
      color: #ccccdd;
      margin-top: 5px;
      line-height: 1.5;
    }

    .project-tech {
      font-size: 8pt;
      color: #aaaacc;
      margin-top: 5px;
    }

    .pub-item {
      margin-bottom: 12px;
    }

    .pub-title {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .pub-info {
      font-size: 8pt;
      color: #aaaacc;
      margin-top: 3px;
    }

    .award-item {
      margin-bottom: 12px;
    }

    .award-title {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .award-info {
      font-size: 8pt;
      color: #aaaacc;
      margin-top: 3px;
    }

    .award-desc {
      font-size: 9pt;
      color: #ccccdd;
      margin-top: 5px;
    }

    .volunteer-item {
      margin-bottom: 15px;
      padding-bottom: 12px;
      border-bottom: 1px solid #5a57a0;
    }

    .volunteer-item:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .volunteer-role {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .volunteer-org {
      font-size: 9pt;
      color: #aaaacc;
    }

    .volunteer-date {
      font-size: 8pt;
      color: {{colors.primary}};
      margin-top: 3px;
    }

    .volunteer-desc {
      font-size: 9pt;
      color: #ccccdd;
      margin-top: 5px;
      line-height: 1.5;
    }

    .interest-item {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
      font-size: 9pt;
      color: #ccccdd;
    }

    .interest-item::before {
      content: '';
      width: 6px;
      height: 6px;
      background: {{colors.primary}};
      border-radius: 50%;
      margin-right: 10px;
    }

    .reference-item {
      margin-bottom: 15px;
    }

    .reference-name {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .reference-title {
      font-size: 9pt;
      color: #aaaacc;
    }

    .reference-contact {
      font-size: 8pt;
      color: {{colors.primary}};
      margin-top: 5px;
    }

    .contact-bar {
      display: flex;
      justify-content: center;
      gap: 40px;
      margin-top: 25px;
      padding: 15px;
      background: #3d3a7e;
      border-radius: 8px;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 9pt;
      color: #ccccdd;
    }

    .contact-icon {
      color: {{colors.primary}};
    }
  </style>
</head>
<body>
  <div class="cv-container">
    <div class="header-card">
      <div class="header-left">
        <div class="name-block">
          <h1>{{personalInfo.firstName}} {{personalInfo.lastName}}</h1>
          <div class="title">{{personalInfo.title}}</div>
        </div>
      </div>
      @if(personalInfo.photoUrl)
      <img src="{{personalInfo.photoUrl}}" alt="Photo" class="photo">
      @endif
    </div>

    @if(summary)
    <div class="summary-card">
      <p class="summary-text">{{summary}}</p>
    </div>
    @endif

    @if(objective)
    <div class="summary-card">
      <h2 class="card-title">Objective</h2>
      <p class="summary-text">{{objective}}</p>
    </div>
    @endif

    <div class="content-grid">
      @if(skills && skills.length)
      <div class="card">
        <h2 class="card-title">Skills</h2>
        @each(skill in skills)
        <div class="skill-category">
          <div class="skill-category-name">{{skill.name}}</div>
          <div class="skill-dots">
            <span class="skill-dot"></span>
            <span class="skill-dot"></span>
            <span class="skill-dot"></span>
            <span class="skill-dot @if(skill.level === 'beginner' || skill.level === 'intermediate')empty@endif"></span>
            <span class="skill-dot @if(skill.level !== 'expert')empty@endif"></span>
          </div>
        </div>
        @endeach
      </div>
      @endif

      @if(experiences && experiences.length)
      <div class="card">
        <h2 class="card-title">Work Experience</h2>
        @each(exp in experiences)
        <div class="experience-item">
          <div class="exp-header">
            <div>
              <div class="exp-title">{{exp.jobTitle}}</div>
              <div class="exp-company">{{exp.company}}</div>
            </div>
            <div class="exp-date">{{exp.startDate}} - @if(exp.current)Present@else{{exp.endDate}}@endif</div>
          </div>
          @if(exp.description)
          <p class="exp-desc">{{exp.description}}</p>
          @endif
          @if(exp.achievements && exp.achievements.length)
          <ul class="exp-achievements">
            @each(achievement in exp.achievements)
            <li>{{achievement}}</li>
            @endeach
          </ul>
          @endif
        </div>
        @endeach
      </div>
      @endif
    </div>

    <div class="bottom-grid">
      @if(certifications && certifications.length)
      <div class="card">
        <h2 class="card-title">Certifications</h2>
        @each(cert in certifications)
        <div class="cert-item">{{cert.name}} - {{cert.issuer}}</div>
        @endeach
      </div>
      @endif

      @if(education && education.length)
      <div class="card">
        <h2 class="card-title">Education</h2>
        @each(edu in education)
        <div class="edu-item">
          <div class="edu-date">{{edu.startDate}} - @if(edu.current)Present@else{{edu.endDate}}@endif</div>
          <div class="edu-degree">{{edu.institution}}</div>
          <div class="edu-school">{{edu.degree}} in {{edu.field}}</div>
        </div>
        @endeach
      </div>
      @endif
    </div>

    @if(languages && languages.length)
    <div class="bottom-grid">
      <div class="card">
        <h2 class="card-title">Languages</h2>
        @each(lang in languages)
        <div class="lang-item">
          <span>{{lang.name}}</span>
          <span class="lang-level">{{lang.proficiency}}</span>
        </div>
        @endeach
      </div>

      @if(interests && interests.length)
      <div class="card">
        <h2 class="card-title">Interests</h2>
        @each(interest in interests)
        <div class="interest-item">{{interest.name}}</div>
        @endeach
      </div>
      @endif
    </div>
    @endif

    @if(projects && projects.length)
    <div class="card" style="margin-bottom: 25px;">
      <h2 class="card-title">Projects</h2>
      @each(project in projects)
      <div class="project-item">
        <div class="project-name">{{project.name}}</div>
        @if(project.url)
        <div class="project-url">{{project.url}}</div>
        @endif
        @if(project.description)
        <p class="project-desc">{{project.description}}</p>
        @endif
        @if(project.technologies && project.technologies.length)
        <div class="project-tech">Technologies: {{project.technologies.join(', ')}}</div>
        @endif
      </div>
      @endeach
    </div>
    @endif

    @if(publications && publications.length)
    <div class="card" style="margin-bottom: 25px;">
      <h2 class="card-title">Publications</h2>
      @each(pub in publications)
      <div class="pub-item">
        <div class="pub-title">{{pub.title}}</div>
        <div class="pub-info">{{pub.publisher}} - {{pub.publicationDate}}</div>
        @if(pub.description)
        <p class="project-desc">{{pub.description}}</p>
        @endif
      </div>
      @endeach
    </div>
    @endif

    @if(awards && awards.length)
    <div class="card" style="margin-bottom: 25px;">
      <h2 class="card-title">Awards</h2>
      @each(award in awards)
      <div class="award-item">
        <div class="award-title">{{award.title}}</div>
        <div class="award-info">{{award.issuer}} - {{award.date}}</div>
        @if(award.description)
        <p class="award-desc">{{award.description}}</p>
        @endif
      </div>
      @endeach
    </div>
    @endif

    @if(volunteer && volunteer.length)
    <div class="card" style="margin-bottom: 25px;">
      <h2 class="card-title">Volunteer Experience</h2>
      @each(vol in volunteer)
      <div class="volunteer-item">
        <div class="volunteer-role">{{vol.role}}</div>
        <div class="volunteer-org">{{vol.organization}}</div>
        <div class="volunteer-date">{{vol.startDate}} - @if(vol.current)Present@else{{vol.endDate}}@endif</div>
        @if(vol.description)
        <p class="volunteer-desc">{{vol.description}}</p>
        @endif
      </div>
      @endeach
    </div>
    @endif

    @if(references && references.length)
    <div class="card" style="margin-bottom: 25px;">
      <h2 class="card-title">References</h2>
      @each(ref in references)
      <div class="reference-item">
        <div class="reference-name">{{ref.name}}</div>
        <div class="reference-title">{{ref.title}}, {{ref.company}}</div>
        <div class="reference-contact">{{ref.email}} @if(ref.phone)| {{ref.phone}}@endif</div>
      </div>
      @endeach
    </div>
    @endif

    <div class="contact-bar">
      @if(personalInfo.phone)
      <div class="contact-item">
        <span class="contact-icon">T</span>
        {{personalInfo.phone}}
      </div>
      @endif
      @if(personalInfo.email)
      <div class="contact-item">
        <span class="contact-icon">@</span>
        {{personalInfo.email}}
      </div>
      @endif
      @each(link in personalInfo.socialLinks)
      <div class="contact-item">
        <span class="contact-icon">W</span>
        {{link.label}}
      </div>
      @endeach
    </div>
  </div>
</body>
</html>
