<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: {{typography.bodySize}}pt;
      line-height: {{typography.lineHeight}};
      background: #2d2a5e;
      color: #ffffff;
      min-height: 100vh;
      padding: 40px;
    }

    .cv-container {
      max-width: 800px;
      margin: 0 auto;
    }

    .header-card {
      background: #3d3a7e;
      border: 2px solid #5a57a0;
      border-radius: 8px;
      padding: 25px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .name-block h1 {
      font-size: 24pt;
      font-weight: 700;
      color: #ffffff;
    }

    .title {
      font-size: 10pt;
      text-transform: uppercase;
      color: {{colors.primary}};
      letter-spacing: 2px;
      margin-top: 5px;
    }

    .photo {
      width: 80px;
      height: 80px;
      border-radius: 8px;
      object-fit: cover;
      background: #4a478a;
    }

    .cursor-icon {
      font-size: 30pt;
      color: {{colors.primary}};
    }

    .summary-card {
      background: #3d3a7e;
      border: 2px solid #5a57a0;
      border-radius: 8px;
      padding: 20px 25px;
      margin-bottom: 25px;
    }

    .summary-text {
      font-size: 10pt;
      color: #ccccdd;
      line-height: 1.6;
    }

    .content-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
      margin-bottom: 25px;
    }

    .card {
      background: #3d3a7e;
      border: 2px solid #5a57a0;
      border-radius: 8px;
      padding: 25px;
    }

    .card-title {
      font-size: 12pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #ffffff;
      margin-bottom: 20px;
    }

    .skill-category {
      margin-bottom: 15px;
    }

    .skill-category-name {
      font-size: 10pt;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 8px;
    }

    .skill-dots {
      display: flex;
      gap: 5px;
    }

    .skill-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: {{colors.primary}};
    }

    .skill-dot.empty {
      background: #5a57a0;
    }

    .experience-item {
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 1px solid #5a57a0;
    }

    .experience-item:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .exp-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
    }

    .exp-date {
      font-size: 9pt;
      font-weight: 700;
      color: {{colors.primary}};
    }

    .exp-title {
      font-size: 11pt;
      font-weight: 700;
      color: #ffffff;
    }

    .exp-company {
      font-size: 9pt;
      color: #aaaacc;
    }

    .exp-desc {
      font-size: 9pt;
      color: #ccccdd;
      margin-top: 8px;
      line-height: 1.5;
    }

    .bottom-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
    }

    .cert-item {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
      font-size: 9pt;
      color: #ccccdd;
    }

    .cert-item::before {
      content: '';
      width: 6px;
      height: 6px;
      background: {{colors.primary}};
      border-radius: 50%;
      margin-right: 10px;
    }

    .edu-item {
      margin-bottom: 15px;
    }

    .edu-date {
      font-size: 9pt;
      font-weight: 700;
      color: {{colors.primary}};
    }

    .edu-degree {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .edu-school {
      font-size: 9pt;
      color: #aaaacc;
    }

    .contact-bar {
      display: flex;
      justify-content: center;
      gap: 40px;
      margin-top: 25px;
      padding: 15px;
      background: #3d3a7e;
      border-radius: 8px;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 9pt;
      color: #ccccdd;
    }

    .contact-icon {
      color: {{colors.primary}};
    }
  </style>
</head>
<body>
  <div class="cv-container">
    <div class="header-card">
      <div class="header-left">
        <div class="name-block">
          <h1>{{personalInfo.firstName}} {{personalInfo.lastName}}</h1>
          <div class="title">{{personalInfo.title}}</div>
        </div>
      </div>
      {{#if personalInfo.photoUrl}}
      <img src="{{personalInfo.photoUrl}}" alt="Photo" class="photo">
      {{/if}}
    </div>

    <div class="summary-card">
      <p class="summary-text">{{summary}}</p>
    </div>

    <div class="content-grid">
      <div class="card">
        <h2 class="card-title">Skills</h2>
        {{#each skills}}
        <div class="skill-category">
          <div class="skill-category-name">{{this.name}}</div>
          <div class="skill-dots">
            <span class="skill-dot"></span>
            <span class="skill-dot"></span>
            <span class="skill-dot"></span>
            <span class="skill-dot {{#if (eq this.level 'beginner')}}empty{{/if}} {{#if (eq this.level 'intermediate')}}empty{{/if}}"></span>
            <span class="skill-dot {{#if (neq this.level 'expert')}}empty{{/if}}"></span>
          </div>
        </div>
        {{/each}}
      </div>

      <div class="card">
        <h2 class="card-title">Work Experience</h2>
        {{#each experiences}}
        <div class="experience-item">
          <div class="exp-header">
            <div>
              <div class="exp-title">{{this.jobTitle}}</div>
              <div class="exp-company">{{this.company}}</div>
            </div>
            <div class="exp-date">{{this.startDate}}</div>
          </div>
          <p class="exp-desc">{{this.description}}</p>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="bottom-grid">
      <div class="card">
        <h2 class="card-title">Certification</h2>
        {{#each certifications}}
        <div class="cert-item">{{this.name}}</div>
        {{/each}}
      </div>

      <div class="card">
        <h2 class="card-title">Education</h2>
        {{#each education}}
        <div class="edu-item">
          <div class="edu-date">{{this.endDate}}</div>
          <div class="edu-degree">{{this.institution}}</div>
          <div class="edu-school">{{this.degree}} in {{this.field}}</div>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="contact-bar">
      {{#if personalInfo.phone}}
      <div class="contact-item">
        <span class="contact-icon">T</span>
        {{personalInfo.phone}}
      </div>
      {{/if}}
      {{#if personalInfo.email}}
      <div class="contact-item">
        <span class="contact-icon">@</span>
        {{personalInfo.email}}
      </div>
      {{/if}}
      {{#each personalInfo.socialLinks}}
      <div class="contact-item">
        <span class="contact-icon">W</span>
        {{this.label}}
      </div>
      {{/each}}
    </div>
  </div>
</body>
</html>
