<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
      font-size: {{typography.bodySize}}pt;
      line-height: {{typography.lineHeight}};
      background: linear-gradient(135deg, #D5D9FF 0%, #E8EBFF 50%, #F0F2FF 100%);
      color: #1a1a2e;
      min-height: 100vh;
      padding: 30px;
    }

    .cv-container {
      max-width: 850px;
      margin: 0 auto;
    }

    /* Window Title Bar Style */
    .window-title-bar {
      background: {{colors.primary}};
      color: white;
      padding: 12px 20px;
      border-radius: 12px 12px 0 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11pt;
      font-weight: 600;
    }

    .window-title-bar .title {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .window-title-bar .title::before {
      content: '';
      width: 12px;
      height: 12px;
      background: #4ADE80;
      border-radius: 50%;
    }

    .window-controls {
      display: flex;
      gap: 8px;
    }

    .window-controls span {
      font-size: 14pt;
      opacity: 0.8;
    }

    /* Main Window Content */
    .window-content {
      background: white;
      border: 3px solid {{colors.primary}};
      border-top: none;
      border-radius: 0 0 12px 12px;
      padding: 25px;
    }

    /* Card/Window Component */
    .os-card {
      background: white;
      border: 2px solid {{colors.primary}};
      border-radius: 12px;
      margin-bottom: 20px;
      overflow: hidden;
    }

    .os-card-header {
      background: {{colors.primary}};
      color: white;
      padding: 10px 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10pt;
      font-weight: 600;
    }

    .os-card-header .controls {
      display: flex;
      gap: 6px;
    }

    .os-card-header .controls span {
      font-size: 12pt;
      opacity: 0.8;
    }

    .os-card-body {
      padding: 20px;
    }

    /* Header Section */
    .header-grid {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 25px;
      align-items: center;
    }

    .photo-container {
      position: relative;
    }

    .photo {
      width: 120px;
      height: 120px;
      border-radius: 12px;
      object-fit: cover;
      border: 3px solid {{colors.primary}};
    }

    .photo-badges {
      position: absolute;
      top: -10px;
      right: -10px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .badge {
      background: {{colors.primary}};
      color: white;
      padding: 4px 8px;
      border-radius: 4px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9pt;
      font-weight: 700;
    }

    .badge.ts {
      background: #3178C6;
    }

    .name-section h1 {
      font-size: 26pt;
      font-weight: 700;
      color: #1a1a2e;
      line-height: 1.1;
    }

    .name-section .subtitle {
      font-size: 11pt;
      color: {{colors.primary}};
      font-weight: 600;
      margin-top: 5px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .contact-info {
      margin-top: 12px;
      font-size: 9pt;
      color: #666;
      line-height: 1.8;
    }

    .contact-info a {
      color: {{colors.primary}};
      text-decoration: none;
    }

    /* Two Column Layout */
    .two-columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    /* Section Titles */
    .section-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11pt;
      font-weight: 700;
      color: #1a1a2e;
      margin-bottom: 15px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title::before {
      content: '';
      width: 8px;
      height: 8px;
      background: {{colors.primary}};
      border-radius: 50%;
    }

    /* Experience Items */
    .experience-item {
      margin-bottom: 18px;
      padding-bottom: 15px;
      border-bottom: 1px dashed #ddd;
    }

    .experience-item:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .exp-title {
      font-size: 11pt;
      font-weight: 700;
      color: #1a1a2e;
    }

    .exp-company {
      font-size: 9pt;
      color: {{colors.primary}};
      font-weight: 600;
      margin-top: 2px;
    }

    .exp-date {
      font-size: 8pt;
      color: #888;
      margin-top: 3px;
    }

    .exp-desc {
      font-size: 9pt;
      color: #555;
      margin-top: 8px;
      line-height: 1.5;
    }

    .exp-achievements {
      margin-top: 8px;
      padding-left: 15px;
    }

    .exp-achievements li {
      font-size: 9pt;
      color: #555;
      margin-bottom: 4px;
    }

    /* Skills with Dots */
    .skill-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .skill-name {
      font-size: 10pt;
      font-weight: 500;
      color: #1a1a2e;
    }

    .skill-dots {
      display: flex;
      gap: 4px;
    }

    .skill-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: {{colors.primary}};
    }

    .skill-dot.empty {
      background: #E0E0E0;
    }

    /* Education */
    .edu-item {
      margin-bottom: 15px;
    }

    .edu-degree {
      font-size: 11pt;
      font-weight: 700;
      color: #1a1a2e;
    }

    .edu-school {
      font-size: 9pt;
      color: {{colors.primary}};
      font-weight: 500;
      margin-top: 2px;
    }

    .edu-date {
      font-size: 8pt;
      color: #888;
      margin-top: 2px;
    }

    .edu-desc {
      font-size: 9pt;
      color: #555;
      margin-top: 5px;
    }

    /* Languages */
    .lang-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      font-size: 10pt;
    }

    .lang-name {
      color: #1a1a2e;
      font-weight: 500;
    }

    .lang-level {
      color: {{colors.primary}};
      font-weight: 600;
    }

    /* Projects Card */
    .project-item {
      margin-bottom: 15px;
      padding-bottom: 12px;
      border-bottom: 1px dashed #ddd;
    }

    .project-item:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .project-name {
      font-size: 10pt;
      font-weight: 700;
      color: #1a1a2e;
    }

    .project-url {
      font-size: 8pt;
      color: {{colors.primary}};
      margin-top: 2px;
    }

    .project-desc {
      font-size: 9pt;
      color: #555;
      margin-top: 5px;
      line-height: 1.4;
    }

    .project-tech {
      font-size: 8pt;
      color: #888;
      margin-top: 5px;
      font-family: 'JetBrains Mono', monospace;
    }

    /* Certifications */
    .cert-item {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
      font-size: 9pt;
      color: #1a1a2e;
    }

    .cert-item::before {
      content: '>';
      color: {{colors.primary}};
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      margin-right: 8px;
    }

    /* Awards/Qualities */
    .award-item {
      margin-bottom: 12px;
    }

    .award-title {
      font-size: 10pt;
      font-weight: 700;
      color: #1a1a2e;
    }

    .award-desc {
      font-size: 9pt;
      color: #555;
      margin-top: 3px;
    }

    /* Interests */
    .interest-item {
      display: inline-block;
      background: #F0F2FF;
      border: 1px solid {{colors.primary}};
      color: {{colors.primary}};
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 9pt;
      font-weight: 500;
      margin: 0 5px 8px 0;
    }

    /* References */
    .reference-item {
      margin-bottom: 15px;
    }

    .reference-name {
      font-size: 10pt;
      font-weight: 700;
      color: #1a1a2e;
    }

    .reference-title {
      font-size: 9pt;
      color: #666;
    }

    .reference-contact {
      font-size: 8pt;
      color: {{colors.primary}};
      margin-top: 3px;
    }

    /* Summary Box */
    .summary-box {
      background: #F8F9FF;
      border-left: 4px solid {{colors.primary}};
      padding: 15px 20px;
      margin-bottom: 20px;
      border-radius: 0 8px 8px 0;
    }

    .summary-box p {
      font-size: 10pt;
      color: #444;
      line-height: 1.6;
    }

    /* Footer Links */
    .footer-links {
      background: {{colors.primary}};
      color: white;
      padding: 15px 20px;
      border-radius: 8px;
      display: flex;
      justify-content: center;
      gap: 30px;
      font-size: 9pt;
      margin-top: 20px;
    }

    .footer-link {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .footer-link::before {
      content: '>';
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
    }

    /* Volunteer */
    .volunteer-item {
      margin-bottom: 15px;
    }

    .volunteer-role {
      font-size: 10pt;
      font-weight: 700;
      color: #1a1a2e;
    }

    .volunteer-org {
      font-size: 9pt;
      color: {{colors.primary}};
      font-weight: 500;
    }

    .volunteer-date {
      font-size: 8pt;
      color: #888;
      margin-top: 2px;
    }

    .volunteer-desc {
      font-size: 9pt;
      color: #555;
      margin-top: 5px;
    }

    /* Publications */
    .pub-item {
      margin-bottom: 12px;
    }

    .pub-title {
      font-size: 10pt;
      font-weight: 700;
      color: #1a1a2e;
    }

    .pub-info {
      font-size: 8pt;
      color: #888;
      margin-top: 2px;
    }

    .pub-desc {
      font-size: 9pt;
      color: #555;
      margin-top: 5px;
    }

    /* Quote */
    .quote-box {
      background: {{colors.primary}};
      color: white;
      padding: 12px 20px;
      border-radius: 8px;
      text-align: center;
      font-style: italic;
      font-size: 10pt;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="cv-container">
    <!-- Main Window -->
    <div class="window-title-bar">
      <div class="title">CV {{personalInfo.lastName | upper}} : {{personalInfo.title | upper}}</div>
      <div class="window-controls">
        <span>—</span>
        <span>×</span>
      </div>
    </div>
    <div class="window-content">
      <!-- Header -->
      <div class="header-grid">
        @if(personalInfo.photoUrl)
        <div class="photo-container">
          <img src="{{personalInfo.photoUrl}}" alt="Photo" class="photo">
          <div class="photo-badges">
            <span class="badge">JS</span>
            <span class="badge ts">TS</span>
          </div>
        </div>
        @endif
        <div class="name-section">
          <h1>{{personalInfo.firstName}} {{personalInfo.lastName}}</h1>
          <div class="subtitle">{{personalInfo.title}}</div>
          <div class="contact-info">
            @if(personalInfo.phone){{personalInfo.phone}}<br>@endif
            @if(personalInfo.email){{personalInfo.email}}<br>@endif
            @each(link in personalInfo.socialLinks)
            <a href="{{link.url}}">{{link.url}}</a><br>
            @endeach
          </div>
        </div>
      </div>

      @if(summary)
      <div class="summary-box" style="margin-top: 20px;">
        <p>{{summary}}</p>
      </div>
      @endif

      <div class="two-columns" style="margin-top: 20px;">
        <!-- Left Column -->
        <div>
          <!-- Experiences Card -->
          @if(experiences && experiences.length)
          <div class="os-card">
            <div class="os-card-header">
              <span>EXPÉRIENCES</span>
              <div class="controls"><span>—</span> <span>×</span></div>
            </div>
            <div class="os-card-body">
              @each(exp in experiences)
              <div class="experience-item">
                <div class="exp-title">{{exp.jobTitle}}</div>
                <div class="exp-company">{{exp.company}}</div>
                <div class="exp-date">{{exp.startDate}} - @if(exp.current)Présent@else{{exp.endDate}}@endif</div>
                @if(exp.description)
                <p class="exp-desc">{{exp.description}}</p>
                @endif
                @if(exp.achievements && exp.achievements.length)
                <ul class="exp-achievements">
                  @each(achievement in exp.achievements)
                  <li>{{achievement}}</li>
                  @endeach
                </ul>
                @endif
              </div>
              @endeach
            </div>
          </div>
          @endif

          <!-- About Me Card -->
          @if(objective)
          <div class="os-card">
            <div class="os-card-header">
              <span>À PROPOS DE MOI</span>
              <div class="controls"><span>—</span> <span>×</span></div>
            </div>
            <div class="os-card-body">
              <p class="exp-desc">{{objective}}</p>
            </div>
          </div>
          @endif

          <!-- Projects Card -->
          @if(projects && projects.length)
          <div class="os-card">
            <div class="os-card-header">
              <span>DES VUES SUR CERTAINS TRAVAUX</span>
              <div class="controls"><span>—</span> <span>×</span></div>
            </div>
            <div class="os-card-body">
              @each(project in projects)
              <div class="project-item">
                <div class="project-name">{{project.name}}</div>
                @if(project.url)
                <div class="project-url">{{project.url}}</div>
                @endif
                @if(project.description)
                <p class="project-desc">{{project.description}}</p>
                @endif
                @if(project.technologies && project.technologies.length)
                <div class="project-tech">{{project.technologies.join(' | ')}}</div>
                @endif
              </div>
              @endeach
            </div>
          </div>
          @endif
        </div>

        <!-- Right Column -->
        <div>
          <!-- Skills Card -->
          @if(skills && skills.length)
          <div class="os-card">
            <div class="os-card-header">
              <span>INTÉRÊTS / COMPÉTENCES</span>
              <div class="controls"><span>—</span> <span>×</span></div>
            </div>
            <div class="os-card-body">
              @each(skill in skills)
              <div class="skill-item">
                <span class="skill-name">{{skill.name}}</span>
                <div class="skill-dots">
                  <span class="skill-dot"></span>
                  <span class="skill-dot"></span>
                  <span class="skill-dot"></span>
                  <span class="skill-dot @if(skill.level === 'beginner' || skill.level === 'intermediate')empty@endif"></span>
                  <span class="skill-dot @if(skill.level !== 'expert')empty@endif"></span>
                </div>
              </div>
              @endeach
            </div>
          </div>
          @endif

          <!-- Education Card -->
          @if(education && education.length)
          <div class="os-card">
            <div class="os-card-header">
              <span>FORMATION</span>
              <div class="controls"><span>—</span> <span>×</span></div>
            </div>
            <div class="os-card-body">
              @each(edu in education)
              <div class="edu-item">
                <div class="edu-degree">{{edu.degree}} en {{edu.field}}</div>
                <div class="edu-school">{{edu.institution}}</div>
                <div class="edu-date">{{edu.startDate}} - @if(edu.current)Présent@else{{edu.endDate}}@endif</div>
                @if(edu.description)
                <p class="edu-desc">{{edu.description}}</p>
                @endif
              </div>
              @endeach
            </div>
          </div>
          @endif

          <!-- Languages Card -->
          @if(languages && languages.length)
          <div class="os-card">
            <div class="os-card-header">
              <span>LANGUES</span>
              <div class="controls"><span>—</span> <span>×</span></div>
            </div>
            <div class="os-card-body">
              @each(lang in languages)
              <div class="lang-item">
                <span class="lang-name">{{lang.name}}</span>
                <span class="lang-level">{{ lang.proficiency === 'native' ? 'Natif' : lang.proficiency === 'fluent' ? 'Courant' : lang.proficiency === 'professional' ? 'Professionnel' : lang.proficiency === 'advanced' ? 'Avancé' : lang.proficiency === 'intermediate' ? 'Intermédiaire' : lang.proficiency === 'conversational' ? 'Conversationnel' : lang.proficiency === 'basic' ? 'Basique' : lang.proficiency === 'beginner' ? 'Débutant' : lang.proficiency }}</span>
              </div>
              @endeach
            </div>
          </div>
          @endif
        </div>
      </div>

      <!-- Certifications -->
      @if(certifications && certifications.length)
      <div class="os-card">
        <div class="os-card-header">
          <span>CERTIFICATIONS</span>
          <div class="controls"><span>—</span> <span>×</span></div>
        </div>
        <div class="os-card-body">
          @each(cert in certifications)
          <div class="cert-item">{{cert.name}} - {{cert.issuer}} ({{cert.issueDate}})</div>
          @endeach
        </div>
      </div>
      @endif

      <!-- Awards/Qualities -->
      @if(awards && awards.length)
      <div class="os-card">
        <div class="os-card-header">
          <span>MAIS AUSSI...</span>
          <div class="controls"><span>—</span> <span>×</span></div>
        </div>
        <div class="os-card-body">
          @each(award in awards)
          <div class="award-item">
            <div class="award-title">{{award.title}}</div>
            @if(award.description)
            <p class="award-desc">{{award.description}}</p>
            @endif
          </div>
          @endeach
        </div>
      </div>
      @endif

      <!-- Interests -->
      @if(interests && interests.length)
      <div class="os-card">
        <div class="os-card-header">
          <span>CENTRES D'INTÉRÊT</span>
          <div class="controls"><span>—</span> <span>×</span></div>
        </div>
        <div class="os-card-body">
          @each(interest in interests)
          <span class="interest-item">{{interest.name}}</span>
          @endeach
        </div>
      </div>
      @endif

      <!-- Volunteer -->
      @if(volunteer && volunteer.length)
      <div class="os-card">
        <div class="os-card-header">
          <span>BÉNÉVOLAT</span>
          <div class="controls"><span>—</span> <span>×</span></div>
        </div>
        <div class="os-card-body">
          @each(vol in volunteer)
          <div class="volunteer-item">
            <div class="volunteer-role">{{vol.role}}</div>
            <div class="volunteer-org">{{vol.organization}}</div>
            <div class="volunteer-date">{{vol.startDate}} - @if(vol.current)Présent@else{{vol.endDate}}@endif</div>
            @if(vol.description)
            <p class="volunteer-desc">{{vol.description}}</p>
            @endif
          </div>
          @endeach
        </div>
      </div>
      @endif

      <!-- Publications -->
      @if(publications && publications.length)
      <div class="os-card">
        <div class="os-card-header">
          <span>PUBLICATIONS</span>
          <div class="controls"><span>—</span> <span>×</span></div>
        </div>
        <div class="os-card-body">
          @each(pub in publications)
          <div class="pub-item">
            <div class="pub-title">{{pub.title}}</div>
            <div class="pub-info">{{pub.publisher}} - {{pub.publicationDate}}</div>
            @if(pub.description)
            <p class="pub-desc">{{pub.description}}</p>
            @endif
          </div>
          @endeach
        </div>
      </div>
      @endif

      <!-- References -->
      @if(references && references.length)
      <div class="os-card">
        <div class="os-card-header">
          <span>RÉFÉRENCES</span>
          <div class="controls"><span>—</span> <span>×</span></div>
        </div>
        <div class="os-card-body">
          @each(ref in references)
          <div class="reference-item">
            <div class="reference-name">{{ref.name}}</div>
            <div class="reference-title">{{ref.title}}, {{ref.company}}</div>
            <div class="reference-contact">{{ref.email}} @if(ref.phone)| {{ref.phone}}@endif</div>
          </div>
          @endeach
        </div>
      </div>
      @endif

      <!-- Footer -->
      <div class="footer-links">
        @if(personalInfo.email)
        <div class="footer-link">{{personalInfo.email}}</div>
        @endif
        @if(personalInfo.phone)
        <div class="footer-link">{{personalInfo.phone}}</div>
        @endif
        @each(link in personalInfo.socialLinks)
        <div class="footer-link">{{link.label || link.url}}</div>
        @endeach
      </div>

      <div class="quote-box">
        La passion couplée au travail dépasse le talent
      </div>
    </div>
  </div>
</body>
</html>
