<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: {{ typography.bodySize }}pt;
      line-height: {{ typography.lineHeight }};
      background: {{ colors.background }};
      color: {{ colors.text }};
    }

    .cv-container {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 32%;
      background: {{ colors.primary }};
      color: #ffffff;
      padding: 0;
    }

    .main-content {
      width: 68%;
      background: {{ colors.background }};
      padding: 40px;
    }

    .sidebar-header {
      padding: 30px 25px;
      text-align: center;
    }

    .sidebar-section {
      padding: 20px 25px;
      border-top: 1px solid rgba(255,255,255,0.1);
    }

    .sidebar-title {
      font-size: 11pt;
      font-weight: 700;
      letter-spacing: 1px;
      color: #ffffff;
      margin-bottom: 15px;
    }

    .photo {
      width: 120px;
      height: 120px;
      border-radius: 8px;
      object-fit: cover;
      background: rgba(255,255,255,0.1);
      margin-bottom: 15px;
    }

    .contact-item {
      display: flex;
      align-items: center;
      margin-bottom: 12px;
      font-size: 9pt;
    }

    .contact-icon {
      width: 24px;
      margin-right: 12px;
      opacity: 0.8;
    }

    .projects-item {
      margin-bottom: 20px;
    }

    .project-title {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .project-subtitle {
      font-size: 9pt;
      opacity: 0.8;
      margin-top: 3px;
    }

    .project-desc {
      font-size: 8pt;
      opacity: 0.7;
      margin-top: 8px;
      line-height: 1.5;
    }

    .achievement-item {
      margin-bottom: 15px;
    }

    .achievement-icon {
      font-size: 12pt;
      margin-bottom: 5px;
    }

    .achievement-title {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .achievement-desc {
      font-size: 8pt;
      opacity: 0.7;
      margin-top: 3px;
      line-height: 1.4;
    }

    .skill-item {
      margin-bottom: 12px;
    }

    .skill-name {
      font-size: 9pt;
      margin-bottom: 5px;
    }

    .skill-bar {
      height: 6px;
      background: rgba(255,255,255,0.2);
      border-radius: 3px;
    }

    .skill-progress {
      height: 100%;
      background: #ffffff;
      border-radius: 3px;
    }

    .courses-item {
      font-size: 9pt;
      margin-bottom: 5px;
      opacity: 0.9;
    }

    .header {
      margin-bottom: 30px;
    }

    .name {
      font-size: 28pt;
      font-weight: 700;
      color: {{ colors.primary }};
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .title {
      font-size: 11pt;
      color: #666;
      margin-top: 5px;
    }

    .contact-bar {
      display: flex;
      gap: 20px;
      margin-top: 10px;
      font-size: 9pt;
      color: #888;
    }

    .section {
      margin-bottom: 30px;
    }

    .section-title {
      font-size: 11pt;
      font-weight: 700;
      text-transform: uppercase;
      color: {{ colors.primary }};
      margin-bottom: 15px;
      padding-bottom: 8px;
      border-bottom: 2px solid {{ colors.primary }};
    }

    .summary-text {
      font-size: 10pt;
      color: {{ colors.text }};
      line-height: 1.7;
      text-align: justify;
    }

    .experience-item {
      margin-bottom: 25px;
    }

    .exp-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
    }

    .exp-title {
      font-size: 11pt;
      font-weight: 700;
      color: {{ colors.primary }};
    }

    .exp-company {
      font-size: 10pt;
      color: #666;
    }

    .exp-date {
      font-size: 9pt;
      color: {{ colors.primary }};
      text-align: right;
    }

    .exp-location {
      font-size: 9pt;
      color: #888;
      text-align: right;
    }

    .exp-achievements {
      margin-top: 10px;
      padding-left: 15px;
    }

    .exp-achievements li {
      font-size: 9pt;
      color: {{ colors.text }};
      margin-bottom: 5px;
      line-height: 1.5;
    }

    .education-item {
      margin-bottom: 20px;
    }

    .edu-header {
      display: flex;
      justify-content: space-between;
    }

    .edu-degree {
      font-size: 11pt;
      font-weight: 700;
      color: {{ colors.primary }};
    }

    .edu-school {
      font-size: 10pt;
      color: #666;
    }

    .edu-date {
      font-size: 9pt;
      color: {{ colors.primary }};
    }

    .edu-location {
      font-size: 9pt;
      color: #888;
    }
  </style>
</head>
<body>
  <div class="cv-container">
    <div class="sidebar">
      <div class="sidebar-header">
        @if(personalInfo.photoUrl)
        <img src="{{ personalInfo.photoUrl }}" alt="Photo" class="photo">
        @endif
      </div>

      @if(projects && projects.length)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Projects</h2>
        @each(project in projects)
        <div class="projects-item">
          <div class="project-title">{{ project.name }}</div>
          <div class="project-subtitle">{{ project.url }}</div>
          <p class="project-desc">{{ project.description }}</p>
        </div>
        @endeach
      </div>
      @endif

      @if(awards && awards.length)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Key Achievements</h2>
        @each(award in awards)
        <div class="achievement-item">
          <div class="achievement-title">{{ award.title }}</div>
          <p class="achievement-desc">{{ award.description }}</p>
        </div>
        @endeach
      </div>
      @endif

      <div class="sidebar-section">
        <h2 class="sidebar-title">Skills</h2>
        @each(skill in skills)
        <div class="skill-item">
          <div class="skill-name">{{ skill.name }}</div>
          <div class="skill-bar">
            <div class="skill-progress" style="width: 85%"></div>
          </div>
        </div>
        @endeach
      </div>

      @if(certifications && certifications.length)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Courses</h2>
        @each(cert in certifications)
        <div class="courses-item">{{ cert.name }}</div>
        @endeach
      </div>
      @endif
    </div>

    <div class="main-content">
      <div class="header">
        <h1 class="name">{{ personalInfo.firstName }} {{ personalInfo.lastName }}</h1>
        <div class="title">{{ personalInfo.title }}</div>
        <div class="contact-bar">
          @if(personalInfo.phone)
          <span>{{ personalInfo.phone }}</span>
          @endif
          @if(personalInfo.email)
          <span>{{ personalInfo.email }}</span>
          @endif
          @if(personalInfo.city)
          <span>{{ personalInfo.city }}, {{ personalInfo.country }}</span>
          @endif
        </div>
      </div>

      @if(summary)
      <div class="section">
        <h2 class="section-title">Summary</h2>
        <p class="summary-text">{{ summary }}</p>
      </div>
      @endif

      @if(experiences && experiences.length)
      <div class="section">
        <h2 class="section-title">Experience</h2>
        @each(exp in experiences)
        <div class="experience-item">
          <div class="exp-header">
            <div>
              <div class="exp-title">{{ exp.jobTitle }}</div>
              <div class="exp-company">{{ exp.company }}</div>
            </div>
            <div>
              <div class="exp-date">{{ exp.startDate }} - {{ exp.current ? 'Present' : exp.endDate }}</div>
              @if(exp.location)
              <div class="exp-location">{{ exp.location }}</div>
              @endif
            </div>
          </div>
          @if(exp.achievements && exp.achievements.length)
          <ul class="exp-achievements">
            @each(achievement in exp.achievements)
            <li>{{ achievement }}</li>
            @endeach
          </ul>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(education && education.length)
      <div class="section">
        <h2 class="section-title">Education</h2>
        @each(edu in education)
        <div class="education-item">
          <div class="edu-header">
            <div>
              <div class="edu-degree">{{ edu.degree }} in {{ edu.field }}</div>
              <div class="edu-school">{{ edu.institution }}</div>
            </div>
            <div>
              <div class="edu-date">{{ edu.startDate }} - {{ edu.endDate }}</div>
              @if(edu.location)
              <div class="edu-location">{{ edu.location }}</div>
              @endif
            </div>
          </div>
        </div>
        @endeach
      </div>
      @endif
    </div>
  </div>
</body>
</html>
