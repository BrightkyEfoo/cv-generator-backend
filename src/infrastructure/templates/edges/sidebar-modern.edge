<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', 'Roboto', Arial, sans-serif;
      font-size: {{typography.bodySize}}pt;
      line-height: {{typography.lineHeight}};
      color: {{colors.text}};
      background: {{colors.background}};
    }

    .cv-container {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 32%;
      background: #f5f5f5;
      color: #333333;
      padding: 0;
    }

    .main-content {
      width: 68%;
      padding: 25px 30px;
      background: {{colors.background}};
    }

    .photo-section {
      padding: 25px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .photo {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      object-fit: cover;
      background: #ddd;
      margin-bottom: 15px;
    }

    .sidebar-name {
      font-size: 16pt;
      font-weight: 800;
      color: #1a1a1a;
      text-transform: uppercase;
      line-height: 1.2;
      margin-bottom: 8px;
    }

    .sidebar-title {
      font-size: 10pt;
      color: {{colors.primary}};
      font-weight: 500;
    }

    .sidebar-divider {
      height: 4px;
      background: linear-gradient(to right, {{colors.primary}} 0%, {{colors.primary}} 30%, #d0d0d0 30%, #d0d0d0 100%);
      margin: 0;
    }

    .sidebar-section {
      padding: 20px 25px;
    }

    .sidebar-section-title {
      font-size: 12pt;
      font-weight: 700;
      letter-spacing: 1px;
      margin-bottom: 15px;
      color: #1a1a1a;
      text-transform: uppercase;
    }

    .contact-item {
      display: flex;
      align-items: flex-start;
      margin-bottom: 12px;
      gap: 12px;
    }

    .contact-icon {
      width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: {{colors.primary}};
      flex-shrink: 0;
      margin-top: 2px;
    }

    .contact-icon svg {
      width: 16px;
      height: 16px;
    }

    .contact-content {
      flex: 1;
    }

    .contact-label {
      font-size: 9pt;
      color: #666;
      margin-bottom: 2px;
    }

    .contact-value {
      font-size: 10pt;
      color: #333;
      word-break: break-word;
    }

    .contact-value a {
      color: {{colors.primary}};
      text-decoration: underline;
    }

    .skill-item {
      margin-bottom: 14px;
    }

    .skill-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 5px;
    }

    .skill-name {
      font-size: 10pt;
      font-weight: 600;
      color: #1a1a1a;
    }

    .skill-category {
      font-size: 8pt;
      color: #888;
    }

    .skill-bar {
      height: 6px;
      background: #d0d0d0;
      border-radius: 3px;
      overflow: hidden;
    }

    .skill-progress {
      height: 100%;
      background: {{colors.primary}};
      border-radius: 3px;
    }

    .language-item {
      margin-bottom: 10px;
    }

    .language-name {
      font-size: 10pt;
      font-weight: 500;
      color: #1a1a1a;
      margin-bottom: 4px;
    }

    .language-bar {
      height: 6px;
      background: #d0d0d0;
      border-radius: 3px;
      overflow: hidden;
    }

    .language-progress {
      height: 100%;
      background: {{colors.primary}};
      border-radius: 3px;
    }

    /* Main Content Styles */
    .summary-section {
      margin-bottom: 25px;
      position: relative;
      padding-left: 25px;
    }

    .quote-mark {
      position: absolute;
      left: 0;
      top: -5px;
      font-size: 48pt;
      color: {{colors.primary}};
      font-family: Georgia, serif;
      line-height: 1;
      opacity: 0.8;
    }

    .summary-text {
      font-size: 11pt;
      color: #333;
      line-height: 1.6;
      text-align: justify;
    }

    .section {
      margin-bottom: 25px;
    }

    .section-title {
      font-size: 14pt;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #1a1a1a;
      margin-bottom: 15px;
    }

    .education-item {
      margin-bottom: 12px;
    }

    .education-degree {
      font-size: 11pt;
      font-weight: 600;
      color: #1a1a1a;
    }

    .education-details {
      font-size: 9pt;
      color: #666;
      margin-top: 2px;
    }

    .qualities-list {
      font-size: 10pt;
      color: #333;
      line-height: 1.8;
    }

    .quality-separator {
      color: {{colors.primary}};
      margin: 0 8px;
    }

    .experience-item {
      margin-bottom: 20px;
    }

    .experience-header {
      display: flex;
      gap: 15px;
      margin-bottom: 8px;
    }

    .experience-dates {
      font-size: 9pt;
      color: #666;
      min-width: 70px;
      line-height: 1.4;
    }

    .experience-info {
      flex: 1;
      border-left: 2px solid #e0e0e0;
      padding-left: 15px;
    }

    .experience-title {
      font-size: 11pt;
      font-weight: 700;
      color: #1a1a1a;
    }

    .experience-company {
      font-size: 10pt;
      color: {{colors.primary}};
      font-weight: 500;
    }

    .experience-description {
      font-size: 10pt;
      color: #555;
      margin-top: 8px;
      line-height: 1.5;
      text-align: justify;
    }

    .experience-achievements {
      margin-top: 8px;
      padding-left: 15px;
    }

    .experience-achievements li {
      font-size: 9pt;
      color: #555;
      margin-bottom: 4px;
    }

    .project-item {
      margin-bottom: 15px;
    }

    .project-name {
      font-size: 11pt;
      font-weight: 600;
      color: #1a1a1a;
    }

    .project-url {
      font-size: 9pt;
      color: {{colors.primary}};
    }

    .project-description {
      font-size: 10pt;
      color: #555;
      margin-top: 5px;
      line-height: 1.5;
    }

    .project-tech {
      font-size: 9pt;
      color: #888;
      margin-top: 5px;
    }

    .award-item, .cert-item, .volunteer-item, .publication-item {
      margin-bottom: 12px;
    }

    .item-title {
      font-size: 11pt;
      font-weight: 600;
      color: #1a1a1a;
    }

    .item-subtitle {
      font-size: 9pt;
      color: #666;
      margin-top: 2px;
    }

    .item-description {
      font-size: 9pt;
      color: #555;
      margin-top: 5px;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <div class="cv-container">
    <div class="sidebar">
      <div class="photo-section">
        @if(personalInfo.photoUrl)
        <img src="{{personalInfo.photoUrl}}" alt="Photo" class="photo">
        @endif
        <div class="sidebar-name">
          {{personalInfo.firstName}}<br>{{personalInfo.lastName}}
        </div>
        <div class="sidebar-title">{{personalInfo.title}}</div>
      </div>

      <div class="sidebar-divider"></div>

      <div class="sidebar-section">
        <h2 class="sidebar-section-title">Contacts</h2>
        @if(personalInfo.phone)
        <div class="contact-item">
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div class="contact-content">
            <div class="contact-label">Telephone</div>
            <div class="contact-value"><a href="tel:{{personalInfo.phone}}">{{personalInfo.phone}}</a></div>
          </div>
        </div>
        @endif
        @if(personalInfo.email)
        <div class="contact-item">
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div class="contact-content">
            <div class="contact-label">Email</div>
            <div class="contact-value"><a href="mailto:{{personalInfo.email}}">{{personalInfo.email}}</a></div>
          </div>
        </div>
        @endif
        @if(personalInfo.city)
        <div class="contact-item">
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div class="contact-content">
            <div class="contact-label">Adresse</div>
            <div class="contact-value">{{personalInfo.city}}@if(personalInfo.country), {{personalInfo.country}}@endif</div>
          </div>
        </div>
        @endif
        @each(link in personalInfo.socialLinks)
        <div class="contact-item">
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
          </div>
          <div class="contact-content">
            <div class="contact-label">{{link.platform}}</div>
            <div class="contact-value"><a href="{{link.url}}">{{link.label}}</a></div>
          </div>
        </div>
        @endeach
      </div>

      @if(skills.length)
      <div class="sidebar-section">
        <h2 class="sidebar-section-title">Competences</h2>
        @each(skill in skills)
        <div class="skill-item">
          <div class="skill-header">
            <span class="skill-name">{{skill.name}}</span>
            @if(skill.category)
            <span class="skill-category">{{skill.category}}</span>
            @endif
          </div>
          <div class="skill-bar">
            <div class="skill-progress" style="width: {{ skill.level === 'expert' ? '100' : skill.level === 'advanced' ? '85' : skill.level === 'intermediate' ? '65' : skill.level === 'beginner' ? '40' : '60' }}%"></div>
          </div>
        </div>
        @endeach
      </div>
      @endif

      @if(languages.length)
      <div class="sidebar-section">
        <h2 class="sidebar-section-title">Langues</h2>
        @each(lang in languages)
        <div class="language-item">
          <div class="language-name">{{lang.name}}</div>
          <div class="language-bar">
            <div class="language-progress" style="width: {{ lang.proficiency === 'native' ? '100' : lang.proficiency === 'fluent' ? '95' : lang.proficiency === 'professional' ? '85' : lang.proficiency === 'advanced' ? '75' : lang.proficiency === 'intermediate' ? '60' : lang.proficiency === 'conversational' ? '50' : lang.proficiency === 'basic' ? '35' : lang.proficiency === 'beginner' ? '20' : '50' }}%"></div>
          </div>
        </div>
        @endeach
      </div>
      @endif

      @if(interests.length)
      <div class="sidebar-section">
        <h2 class="sidebar-section-title">Interets</h2>
        @each(interest in interests)
        <div class="contact-value" style="margin-bottom: 5px;">{{interest.name}}</div>
        @endeach
      </div>
      @endif
    </div>

    <div class="main-content">
      @if(summary)
      <div class="summary-section">
        <span class="quote-mark">"</span>
        <p class="summary-text">{{summary}}</p>
      </div>
      @endif

      @if(education.length)
      <div class="section">
        <h2 class="section-title">Education</h2>
        @each(edu in education)
        <div class="education-item">
          <div class="education-degree">{{edu.degree}}@if(edu.fieldOfStudy) en {{edu.fieldOfStudy}}@endif</div>
          <div class="education-details">{{edu.endDate}} &bull; {{edu.institution}}</div>
        </div>
        @endeach
      </div>
      @endif

      @if(awards.length)
      <div class="section">
        <h2 class="section-title">Qualites</h2>
        <div class="qualities-list">
          @each(award in awards)
          {{award.title}}@if(!$loop.last)<span class="quality-separator">|</span>@endif
          @endeach
        </div>
      </div>
      @endif

      @if(experiences.length)
      <div class="section">
        <h2 class="section-title">Experiences</h2>
        @each(exp in experiences)
        <div class="experience-item">
          <div class="experience-header">
            <div class="experience-dates">
              {{exp.startDate}}<br>
              @if(exp.current)
              Présent
              @else
              {{exp.endDate}}
              @endif
            </div>
            <div class="experience-info">
              <div class="experience-title">{{exp.jobTitle}}</div>
              <div class="experience-company">{{exp.company}}</div>
            </div>
          </div>
          @if(exp.description)
          <div class="experience-description">{{exp.description}}</div>
          @endif
          @if(exp.achievements && exp.achievements.length)
          <ul class="experience-achievements">
            @each(achievement in exp.achievements)
            <li>{{achievement}}</li>
            @endeach
          </ul>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(projects.length)
      <div class="section">
        <h2 class="section-title">Projets</h2>
        @each(project in projects)
        <div class="project-item">
          <div class="project-name">{{project.name}}</div>
          @if(project.url)
          <div class="project-url">{{project.url}}</div>
          @endif
          <div class="project-description">{{project.description}}</div>
          @if(project.technologies && project.technologies.length)
          <div class="project-tech">Technologies: {{project.technologies.join(', ')}}</div>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(certifications.length)
      <div class="section">
        <h2 class="section-title">Certifications</h2>
        @each(cert in certifications)
        <div class="cert-item">
          <div class="item-title">{{cert.name}}</div>
          <div class="item-subtitle">{{cert.issuer}} - {{cert.issueDate}}</div>
        </div>
        @endeach
      </div>
      @endif

      @if(publications.length)
      <div class="section">
        <h2 class="section-title">Publications</h2>
        @each(pub in publications)
        <div class="publication-item">
          <div class="item-title">{{pub.title}}</div>
          <div class="item-subtitle">{{pub.publisher}} - {{pub.publicationDate}}</div>
          @if(pub.description)
          <div class="item-description">{{pub.description}}</div>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(volunteer.length)
      <div class="section">
        <h2 class="section-title">Benevolat</h2>
        @each(vol in volunteer)
        <div class="volunteer-item">
          <div class="item-title">{{vol.role}}</div>
          <div class="item-subtitle">{{vol.organization}} | {{vol.startDate}} - @if(vol.current)Présent@else{{vol.endDate}}@endif</div>
          @if(vol.description)
          <div class="item-description">{{vol.description}}</div>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(references.length)
      <div class="section">
        <h2 class="section-title">References</h2>
        @each(ref in references)
        <div class="cert-item">
          <div class="item-title">{{ref.name}}</div>
          <div class="item-subtitle">{{ref.title}} - {{ref.company}}</div>
          <div class="item-description">{{ref.email}} | {{ref.phone}}</div>
        </div>
        @endeach
      </div>
      @endif
    </div>
  </div>
</body>
</html>
