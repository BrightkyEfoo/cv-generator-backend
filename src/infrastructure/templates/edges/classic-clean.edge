<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Georgia', 'Times New Roman', serif;
      font-size: {{ typography.bodySize }}pt;
      line-height: {{ typography.lineHeight }};
      background: {{ colors.background }};
      color: {{ colors.text }};
      padding: 40px;
    }

    .cv-container {
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      gap: 30px;
    }

    .sidebar {
      width: 30%;
    }

    .main-content {
      width: 70%;
    }

    .photo-container {
      margin-bottom: 25px;
    }

    .photo {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      background: #eee;
    }

    .header {
      margin-bottom: 30px;
      border-bottom: 2px solid {{ colors.headings }};
      padding-bottom: 15px;
    }

    .name {
      font-size: 24pt;
      font-weight: 700;
      color: {{ colors.headings }};
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .title {
      font-size: 10pt;
      color: #666;
      margin-top: 5px;
      font-style: italic;
    }

    .sidebar-section {
      margin-bottom: 25px;
    }

    .sidebar-title {
      font-size: 9pt;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: {{ colors.headings }};
      margin-bottom: 12px;
      padding-bottom: 5px;
      border-bottom: 1px solid #ddd;
    }

    .contact-item {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
      font-size: 9pt;
    }

    .contact-icon {
      width: 18px;
      height: 18px;
      background: {{ colors.headings }};
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 10px;
      font-size: 8px;
    }

    .skill-item {
      margin-bottom: 8px;
    }

    .skill-name {
      font-size: 9pt;
      font-weight: 600;
      color: {{ colors.text }};
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .skill-bar {
      height: 4px;
      background: #eee;
      margin-top: 4px;
    }

    .skill-progress {
      height: 100%;
      background: {{ colors.headings }};
    }

    .language-item {
      font-size: 9pt;
      margin-bottom: 5px;
      display: flex;
      justify-content: space-between;
    }

    .section {
      margin-bottom: 25px;
    }

    .section-title {
      font-size: 10pt;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: {{ colors.headings }};
      margin-bottom: 15px;
      padding-bottom: 5px;
      border-bottom: 1px solid #ddd;
    }

    .about-text {
      font-size: 10pt;
      color: {{ colors.text }};
      line-height: 1.7;
      text-align: justify;
      font-style: italic;
    }

    .education-grid {
      display: grid;
      grid-template-columns: 100px 1fr;
      gap: 15px;
    }

    .edu-item {
      display: contents;
    }

    .edu-date {
      font-size: 9pt;
      color: #888;
    }

    .edu-content {}

    .edu-degree {
      font-size: 10pt;
      font-weight: 700;
      color: {{ colors.headings }};
    }

    .edu-school {
      font-size: 9pt;
      color: #666;
      font-style: italic;
    }

    .experience-grid {
      display: grid;
      grid-template-columns: 100px 1fr;
      gap: 15px;
    }

    .exp-item {
      display: contents;
    }

    .exp-date {
      font-size: 9pt;
      color: #888;
    }

    .exp-content {}

    .exp-title {
      font-size: 10pt;
      font-weight: 700;
      color: {{ colors.headings }};
      text-transform: uppercase;
    }

    .exp-company {
      font-size: 9pt;
      color: #666;
      font-style: italic;
    }

    .exp-desc {
      font-size: 9pt;
      color: {{ colors.text }};
      margin-top: 8px;
      line-height: 1.6;
    }

    .exp-achievements {
      margin-top: 8px;
      padding-left: 15px;
    }

    .exp-achievements li {
      font-size: 9pt;
      color: {{ colors.text }};
      margin-bottom: 4px;
    }
  </style>
</head>
<body>
  <div class="cv-container">
    <div class="sidebar">
      @if(personalInfo.photoUrl)
      <div class="photo-container">
        <img src="{{ personalInfo.photoUrl }}" alt="Photo" class="photo">
      </div>
      @endif

      <div class="sidebar-section">
        <h2 class="sidebar-title">Contact</h2>
        @if(personalInfo.phone)
        <div class="contact-item">
          <span class="contact-icon">T</span>
          {{ personalInfo.phone }}
        </div>
        @endif
        @if(personalInfo.email)
        <div class="contact-item">
          <span class="contact-icon">@</span>
          {{ personalInfo.email }}
        </div>
        @endif
        @if(personalInfo.city)
        <div class="contact-item">
          <span class="contact-icon">A</span>
          {{ personalInfo.city }}, {{ personalInfo.country }}
        </div>
        @endif
        @each(link in personalInfo.socialLinks)
        <div class="contact-item">
          <span class="contact-icon">W</span>
          {{ link.label }}
        </div>
        @endeach
      </div>

      <div class="sidebar-section">
        <h2 class="sidebar-title">Skills</h2>
        @each(skill in skills)
        <div class="skill-item">
          <div class="skill-name">{{ skill.name }}</div>
          <div class="skill-bar">
            <div class="skill-progress" style="width: {{ skill.level === 'expert' ? '100' : skill.level === 'advanced' ? '80' : skill.level === 'intermediate' ? '60' : skill.level === 'beginner' ? '40' : '50' }}%"></div>
          </div>
        </div>
        @endeach
      </div>

      <div class="sidebar-section">
        <h2 class="sidebar-title">Languages</h2>
        @each(lang in languages)
        <div class="language-item">
          <span>{{ lang.name }}</span>
          <span>{{ lang.proficiency === 'native' ? 'Langue maternelle' : lang.proficiency === 'fluent' ? 'Courant' : lang.proficiency === 'professional' ? 'Professionnel' : lang.proficiency === 'advanced' ? 'Avancé' : lang.proficiency === 'intermediate' ? 'Intermédiaire' : lang.proficiency === 'conversational' ? 'Conversationnel' : lang.proficiency === 'basic' ? 'Basique' : lang.proficiency === 'beginner' ? 'Débutant' : lang.proficiency }}</span>
        </div>
        @endeach
      </div>

      @if(certifications && certifications.length)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Certifications</h2>
        @each(cert in certifications)
        <div class="skill-item">
          <div class="skill-name">{{ cert.name }}</div>
          <div style="font-size: 8pt; color: #666;">{{ cert.issuer }}</div>
        </div>
        @endeach
      </div>
      @endif

      @if(interests && interests.length)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Interests</h2>
        @each(interest in interests)
        <div class="language-item">
          <span>{{ interest.name }}</span>
        </div>
        @endeach
      </div>
      @endif
    </div>

    <div class="main-content">
      <div class="header">
        <h1 class="name">{{ personalInfo.firstName }} {{ personalInfo.lastName }}</h1>
        <div class="title">{{ personalInfo.title }}</div>
      </div>

      @if(summary)
      <div class="section">
        <h2 class="section-title">About Me</h2>
        <p class="about-text">{{ summary }}</p>
      </div>
      @endif

      @if(objective)
      <div class="section">
        <h2 class="section-title">Objective</h2>
        <p class="about-text">{{ objective }}</p>
      </div>
      @endif

      @if(education && education.length)
      <div class="section">
        <h2 class="section-title">Education</h2>
        <div class="education-grid">
          @each(edu in education)
          <div class="edu-item">
            <div class="edu-date">{{ edu.startDate }}<br>{{ edu.endDate }}</div>
            <div class="edu-content">
              <div class="edu-degree">{{ edu.degree }}</div>
              <div class="edu-school">{{ edu.institution }}</div>
            </div>
          </div>
          @endeach
        </div>
      </div>
      @endif

      @if(experiences && experiences.length)
      <div class="section">
        <h2 class="section-title">Work Experience</h2>
        <div class="experience-grid">
          @each(exp in experiences)
          <div class="exp-item">
            <div class="exp-date">{{ exp.startDate }}<br>{{ exp.current ? 'Present' : exp.endDate }}</div>
            <div class="exp-content">
              <div class="exp-title">{{ exp.jobTitle }}</div>
              <div class="exp-company">{{ exp.company }}</div>
              <p class="exp-desc">{{ exp.description }}</p>
              @if(exp.achievements && exp.achievements.length)
              <ul class="exp-achievements">
                @each(achievement in exp.achievements)
                <li>{{ achievement }}</li>
                @endeach
              </ul>
              @endif
            </div>
          </div>
          @endeach
        </div>
      </div>
      @endif

      @if(projects && projects.length)
      <div class="section">
        <h2 class="section-title">Projects</h2>
        <div class="experience-grid">
          @each(project in projects)
          <div class="exp-item">
            <div class="exp-date">{{ project.startDate }}<br>{{ project.endDate }}</div>
            <div class="exp-content">
              <div class="exp-title">{{ project.name }}</div>
              <p class="exp-desc">{{ project.description }}</p>
            </div>
          </div>
          @endeach
        </div>
      </div>
      @endif

      @if(publications && publications.length)
      <div class="section">
        <h2 class="section-title">Publications</h2>
        @each(pub in publications)
        <div style="margin-bottom: 10px;">
          <div class="exp-title">{{ pub.title }}</div>
          <div class="exp-company">{{ pub.publisher }} - {{ pub.publicationDate }}</div>
        </div>
        @endeach
      </div>
      @endif

      @if(awards && awards.length)
      <div class="section">
        <h2 class="section-title">Awards</h2>
        @each(award in awards)
        <div style="margin-bottom: 10px;">
          <div class="exp-title">{{ award.title }}</div>
          <div class="exp-company">{{ award.issuer }} - {{ award.date }}</div>
        </div>
        @endeach
      </div>
      @endif

      @if(volunteer && volunteer.length)
      <div class="section">
        <h2 class="section-title">Volunteer Experience</h2>
        <div class="experience-grid">
          @each(vol in volunteer)
          <div class="exp-item">
            <div class="exp-date">{{ vol.startDate }}<br>{{ vol.current ? 'Present' : vol.endDate }}</div>
            <div class="exp-content">
              <div class="exp-title">{{ vol.role }}</div>
              <div class="exp-company">{{ vol.organization }}</div>
              @if(vol.description)
              <p class="exp-desc">{{ vol.description }}</p>
              @endif
            </div>
          </div>
          @endeach
        </div>
      </div>
      @endif

      @if(references && references.length)
      <div class="section">
        <h2 class="section-title">References</h2>
        @each(ref in references)
        <div style="margin-bottom: 10px;">
          <div class="exp-title">{{ ref.name }}</div>
          <div class="exp-company">{{ ref.title }}, {{ ref.company }}</div>
          <div style="font-size: 9pt; color: #666;">{{ ref.email }}</div>
        </div>
        @endeach
      </div>
      @endif
    </div>
  </div>
</body>
</html>
