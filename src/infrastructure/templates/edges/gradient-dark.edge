<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: {{ typography.bodySize }}pt;
      line-height: {{ typography.lineHeight }};
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      color: #ffffff;
      min-height: 100vh;
      padding: 13px;
    }

    .cv-container {
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      gap: 13px;
    }

    .left-column {
      width: 45%;
    }

    .right-column {
      width: 55%;
    }

    .header {
      margin-bottom: 30px;
    }

    .name {
      font-size: 32pt;
      font-weight: 300;
      color: #ffffff;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .name strong {
      font-weight: 700;
    }

    .title-badge {
      display: inline-block;
      border: 1px solid {{ colors.primary }};
      padding: 8px 20px;
      margin-top: 15px;
      font-size: 10pt;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #ffffff;
    }

    .photo-container {
      margin: 30px 0;
      text-align: center;
    }

    .photo {
      width: 160px;
      height: 160px;
      border-radius: 50%;
      border: 3px solid {{ colors.primary }};
      object-fit: cover;
      background: #2a2a4e;
    }

    .section {
      margin-bottom: 30px;
    }

    .section-title {
      font-size: 11pt;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: {{ colors.primary }};
      margin-bottom: 15px;
    }

    .about-text {
      font-size: 10pt;
      color: #ccccdd;
      line-height: 1.7;
      text-align: justify;
    }

    .skill-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .skill-tag {
      border-radius: 20px;
      padding: 8px 15px;
      font-size: 9pt;
      color: #ffffff;
    }

    .skill-tag.expert {
      background: {{ colors.primary }};
      border: 2px solid {{ colors.primary }};
    }

    .skill-tag.advanced {
      background: rgba(255,255,255,0.1);
      border: 2px solid {{ colors.primary }};
    }

    .skill-tag.intermediate {
      border: 1px solid {{ colors.primary }};
    }

    .skill-tag.beginner {
      border: 1px dashed {{ colors.primary }};
      opacity: 0.8;
    }

    .skill-tag.default {
      border: 1px solid {{ colors.primary }};
    }

    .education-item {
      margin-bottom: 20px;
      padding-left: 15px;
      border-left: 2px solid {{ colors.primary }};
    }

    .edu-date {
      font-size: 9pt;
      color: {{ colors.primary }};
      font-weight: 700;
    }

    .edu-degree {
      font-size: 11pt;
      font-weight: 700;
      color: #ffffff;
      margin-top: 3px;
    }

    .edu-school {
      font-size: 9pt;
      color: #aaaacc;
    }

    .edu-desc {
      font-size: 9pt;
      color: #ccccdd;
      margin-top: 5px;
      line-height: 1.5;
    }

    .experience-item {
      margin-bottom: 25px;
      padding-left: 15px;
      border-left: 2px solid {{ colors.primary }};
    }

    .exp-date {
      font-size: 9pt;
      color: {{ colors.primary }};
      font-weight: 700;
    }

    .exp-title {
      font-size: 11pt;
      font-weight: 700;
      color: #ffffff;
      margin-top: 3px;
    }

    .exp-company {
      font-size: 9pt;
      color: #aaaacc;
    }

    .exp-desc {
      font-size: 9pt;
      color: #ccccdd;
      margin-top: 8px;
      line-height: 1.5;
    }

    .exp-achievements {
      margin-top: 10px;
      padding-left: 15px;
    }

    .exp-achievements li {
      font-size: 9pt;
      color: #ccccdd;
      margin-bottom: 5px;
    }

    .lang-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 9pt;
      color: #ccccdd;
    }

    .lang-level {
      color: {{ colors.primary }};
    }

    .cert-item {
      margin-bottom: 12px;
      padding-left: 15px;
      border-left: 2px solid {{ colors.primary }};
    }

    .cert-name {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .cert-info {
      font-size: 8pt;
      color: #aaaacc;
      margin-top: 3px;
    }

    .project-item {
      margin-bottom: 20px;
      padding-left: 15px;
      border-left: 2px solid {{ colors.primary }};
    }

    .project-name {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .project-url {
      font-size: 8pt;
      color: {{ colors.primary }};
      margin-top: 3px;
    }

    .project-desc {
      font-size: 9pt;
      color: #ccccdd;
      margin-top: 5px;
      line-height: 1.5;
    }

    .project-tech {
      font-size: 8pt;
      color: #aaaacc;
      margin-top: 5px;
    }

    .pub-item {
      margin-bottom: 15px;
      padding-left: 15px;
      border-left: 2px solid {{ colors.primary }};
    }

    .pub-title {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .pub-info {
      font-size: 8pt;
      color: #aaaacc;
      margin-top: 3px;
    }

    .pub-desc {
      font-size: 9pt;
      color: #ccccdd;
      margin-top: 5px;
    }

    .award-item {
      margin-bottom: 15px;
      padding-left: 15px;
      border-left: 2px solid {{ colors.primary }};
    }

    .award-title {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .award-info {
      font-size: 8pt;
      color: #aaaacc;
      margin-top: 3px;
    }

    .award-desc {
      font-size: 9pt;
      color: #ccccdd;
      margin-top: 5px;
    }

    .volunteer-item {
      margin-bottom: 20px;
      padding-left: 15px;
      border-left: 2px solid {{ colors.primary }};
    }

    .volunteer-role {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .volunteer-org {
      font-size: 9pt;
      color: #aaaacc;
    }

    .volunteer-date {
      font-size: 8pt;
      color: {{ colors.primary }};
      margin-top: 3px;
    }

    .volunteer-desc {
      font-size: 9pt;
      color: #ccccdd;
      margin-top: 5px;
      line-height: 1.5;
    }

    .interest-tag {
      border: 1px solid {{ colors.primary }};
      border-radius: 20px;
      padding: 8px 15px;
      font-size: 9pt;
      color: #ffffff;
    }

    .reference-item {
      margin-bottom: 15px;
      padding-left: 15px;
      border-left: 2px solid {{ colors.primary }};
    }

    .reference-name {
      font-size: 10pt;
      font-weight: 700;
      color: #ffffff;
    }

    .reference-title {
      font-size: 9pt;
      color: #aaaacc;
    }

    .reference-contact {
      font-size: 8pt;
      color: {{ colors.primary }};
      margin-top: 3px;
    }

    .contact-section {
      margin-top: 30px;
    }

    .contact-item {
      display: flex;
      align-items: center;
      margin-bottom: 10px;
      font-size: 9pt;
      color: #ccccdd;
    }

    .contact-icon {
      width: 24px;
      height: 24px;
      border: 1px solid {{ colors.primary }};
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 12px;
      font-size: 10px;
      color: {{ colors.primary }};
    }
  </style>
</head>
<body>
  <div class="cv-container">
    <div class="left-column">
      <div class="header">
        <h1 class="name">{{ personalInfo.firstName }}<br><strong>{{ personalInfo.lastName }}</strong></h1>
        <div class="title-badge">{{ personalInfo.title }}</div>
      </div>

      @if(personalInfo.photoUrl)
      <div class="photo-container">
        <img src="{{ personalInfo.photoUrl }}" alt="Photo" class="photo">
      </div>
      @endif

      @if(summary)
      <div class="section">
        <h2 class="section-title">About</h2>
        <p class="about-text">{{ summary }}</p>
      </div>
      @endif

      @if(objective)
      <div class="section">
        <h2 class="section-title">Objective</h2>
        <p class="about-text">{{ objective }}</p>
      </div>
      @endif

      @if(skills && skills.length)
      <div class="section">
        <h2 class="section-title">Skills</h2>
        <div class="skill-grid">
          @each(skill in skills)
          <span class="skill-tag {{ skill.level === 'expert' ? 'expert' : skill.level === 'advanced' ? 'advanced' : skill.level === 'intermediate' ? 'intermediate' : skill.level === 'beginner' ? 'beginner' : 'default' }}">{{ skill.name }}</span>
          @endeach
        </div>
      </div>
      @endif

      @if(education && education.length)
      <div class="section">
        <h2 class="section-title">Education</h2>
        @each(edu in education)
        <div class="education-item">
          <div class="edu-date">{{ edu.startDate }} - @if(edu.current)Present@else{{ edu.endDate }}@endif</div>
          <div class="edu-degree">{{ edu.degree }}</div>
          <div class="edu-school">{{ edu.institution }}</div>
          @if(edu.description)
          <p class="edu-desc">{{ edu.description }}</p>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(languages && languages.length)
      <div class="section">
        <h2 class="section-title">Languages</h2>
        @each(lang in languages)
        <div class="lang-item">
          <span>{{ lang.name }}</span>
          <span class="lang-level">{{ lang.proficiency === 'native' ? 'Langue maternelle' : lang.proficiency === 'fluent' ? 'Courant' : lang.proficiency === 'professional' ? 'Professionnel' : lang.proficiency === 'advanced' ? 'Avancé' : lang.proficiency === 'intermediate' ? 'Intermédiaire' : lang.proficiency === 'conversational' ? 'Conversationnel' : lang.proficiency === 'basic' ? 'Basique' : lang.proficiency === 'beginner' ? 'Débutant' : lang.proficiency }}</span>
        </div>
        @endeach
      </div>
      @endif

      @if(certifications && certifications.length)
      <div class="section">
        <h2 class="section-title">Certifications</h2>
        @each(cert in certifications)
        <div class="cert-item">
          <div class="cert-name">{{ cert.name }}</div>
          <div class="cert-info">{{ cert.issuer }} - {{ cert.issueDate }}</div>
        </div>
        @endeach
      </div>
      @endif

      @if(interests && interests.length)
      <div class="section">
        <h2 class="section-title">Interests</h2>
        <div class="skill-grid">
          @each(interest in interests)
          <span class="interest-tag">{{ interest.name }}</span>
          @endeach
        </div>
      </div>
      @endif

      <div class="contact-section">
        <h2 class="section-title">Contact</h2>
        @if(personalInfo.phone)
        <div class="contact-item">
          <span class="contact-icon">T</span>
          {{ personalInfo.phone }}
        </div>
        @endif
        @if(personalInfo.email)
        <div class="contact-item">
          <span class="contact-icon">@</span>
          {{ personalInfo.email }}
        </div>
        @endif
        @if(personalInfo.city)
        <div class="contact-item">
          <span class="contact-icon">A</span>
          {{ personalInfo.city }}, {{ personalInfo.country }}
        </div>
        @endif
        @each(link in personalInfo.socialLinks)
        <div class="contact-item">
          <span class="contact-icon">{{ link.platform[0] }}</span>
          {{ link.label }}
        </div>
        @endeach
      </div>
    </div>

    <div class="right-column">
      @if(experiences && experiences.length)
      <div class="section">
        <h2 class="section-title">Experience</h2>
        @each(exp in experiences)
        <div class="experience-item">
          <div class="exp-date">{{ exp.startDate }} - @if(exp.current)Present@else{{ exp.endDate }}@endif</div>
          <div class="exp-title">{{ exp.jobTitle }}</div>
          <div class="exp-company">{{ exp.company }}@if(exp.location), {{ exp.location }}@endif</div>
          @if(exp.description)
          <p class="exp-desc">{{ exp.description }}</p>
          @endif
          @if(exp.achievements && exp.achievements.length)
          <ul class="exp-achievements">
            @each(achievement in exp.achievements)
            <li>{{ achievement }}</li>
            @endeach
          </ul>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(projects && projects.length)
      <div class="section">
        <h2 class="section-title">Projects</h2>
        @each(project in projects)
        <div class="project-item">
          <div class="project-name">{{ project.name }}</div>
          @if(project.url)
          <div class="project-url">{{ project.url }}</div>
          @endif
          @if(project.description)
          <p class="project-desc">{{ project.description }}</p>
          @endif
          @if(project.technologies && project.technologies.length)
          <div class="project-tech">Technologies: {{ project.technologies.join(', ') }}</div>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(publications && publications.length)
      <div class="section">
        <h2 class="section-title">Publications</h2>
        @each(pub in publications)
        <div class="pub-item">
          <div class="pub-title">{{ pub.title }}</div>
          <div class="pub-info">{{ pub.publisher }} - {{ pub.publicationDate }}</div>
          @if(pub.description)
          <p class="pub-desc">{{ pub.description }}</p>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(awards && awards.length)
      <div class="section">
        <h2 class="section-title">Awards</h2>
        @each(award in awards)
        <div class="award-item">
          <div class="award-title">{{ award.title }}</div>
          <div class="award-info">{{ award.issuer }} - {{ award.date }}</div>
          @if(award.description)
          <p class="award-desc">{{ award.description }}</p>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(volunteer && volunteer.length)
      <div class="section">
        <h2 class="section-title">Volunteer Experience</h2>
        @each(vol in volunteer)
        <div class="volunteer-item">
          <div class="volunteer-role">{{ vol.role }}</div>
          <div class="volunteer-org">{{ vol.organization }}</div>
          <div class="volunteer-date">{{ vol.startDate }} - @if(vol.current)Present@else{{ vol.endDate }}@endif</div>
          @if(vol.description)
          <p class="volunteer-desc">{{ vol.description }}</p>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(references && references.length)
      <div class="section">
        <h2 class="section-title">References</h2>
        @each(ref in references)
        <div class="reference-item">
          <div class="reference-name">{{ ref.name }}</div>
          <div class="reference-title">{{ ref.title }}, {{ ref.company }}</div>
          <div class="reference-contact">{{ ref.email }}@if(ref.phone) | {{ ref.phone }}@endif</div>
        </div>
        @endeach
      </div>
      @endif
    </div>
  </div>
</body>
</html>
