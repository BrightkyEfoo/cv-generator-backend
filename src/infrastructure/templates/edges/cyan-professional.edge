<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: {{typography.bodySize}}pt;
      line-height: {{typography.lineHeight}};
      background: {{colors.background}};
      color: {{colors.text}};
    }

    .cv-container {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 35%;
      background: #2a3a4a;
      color: #ffffff;
      padding: 0;
    }

    .main-content {
      width: 65%;
      background: {{colors.background}};
      padding: 0;
    }

    .header-bar {
      background: {{colors.primary}};
      padding: 20px 30px;
      color: #ffffff;
    }

    .name {
      font-size: 24pt;
      font-weight: 300;
      letter-spacing: 8px;
      text-transform: uppercase;
    }

    .title {
      font-size: 10pt;
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-top: 5px;
      opacity: 0.9;
    }

    .header-contact {
      display: flex;
      gap: 20px;
      margin-top: 15px;
      font-size: 8pt;
    }

    .header-contact-item {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .header-contact-icon {
      width: 16px;
      height: 16px;
      border: 1px solid #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 8px;
    }

    .photo-section {
      padding: 30px;
      text-align: center;
    }

    .photo {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      border: 4px solid {{colors.primary}};
      object-fit: cover;
      background: #3a4a5a;
    }

    .sidebar-section {
      padding: 20px 30px;
    }

    .sidebar-title {
      font-size: 10pt;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #ffffff;
      margin-bottom: 15px;
      padding-bottom: 8px;
      border-bottom: 1px solid #4a5a6a;
    }

    .profile-text {
      font-size: 9pt;
      color: #aabbcc;
      line-height: 1.6;
      text-align: justify;
    }

    .edu-item {
      margin-bottom: 15px;
    }

    .edu-degree {
      font-size: 9pt;
      font-weight: 700;
      color: #ffffff;
      text-transform: uppercase;
    }

    .edu-school {
      font-size: 9pt;
      color: #aabbcc;
      font-style: italic;
    }

    .edu-date {
      font-size: 8pt;
      color: #8899aa;
    }

    .skill-item {
      margin-bottom: 10px;
    }

    .skill-name {
      font-size: 9pt;
      color: #ffffff;
      margin-bottom: 5px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .skill-bar {
      height: 6px;
      background: #4a5a6a;
      border-radius: 3px;
    }

    .skill-progress {
      height: 100%;
      background: {{colors.primary}};
      border-radius: 3px;
    }

    .language-item {
      display: flex;
      justify-content: space-between;
      font-size: 9pt;
      color: #aabbcc;
      margin-bottom: 5px;
    }

    .cert-item {
      margin-bottom: 10px;
    }

    .cert-name {
      font-size: 9pt;
      font-weight: 700;
      color: #ffffff;
    }

    .cert-info {
      font-size: 8pt;
      color: #aabbcc;
    }

    .interest-item {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
      font-size: 9pt;
      color: #aabbcc;
    }

    .interest-item::before {
      content: '';
      width: 6px;
      height: 6px;
      background: {{colors.primary}};
      border-radius: 50%;
      margin-right: 10px;
    }

    .reference-item {
      margin-bottom: 12px;
    }

    .reference-name {
      font-size: 9pt;
      font-weight: 700;
      color: #ffffff;
    }

    .reference-title {
      font-size: 8pt;
      color: #aabbcc;
    }

    .reference-contact {
      font-size: 8pt;
      color: {{colors.primary}};
      margin-top: 3px;
    }

    .main-section {
      padding: 25px 40px;
    }

    .main-title {
      font-size: 11pt;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: {{colors.headings}};
      margin-bottom: 20px;
      padding-bottom: 8px;
      border-bottom: 2px solid {{colors.primary}};
    }

    .experience-item {
      margin-bottom: 25px;
    }

    .exp-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 10px;
    }

    .exp-date {
      font-size: 9pt;
      font-weight: 700;
      color: {{colors.primary}};
    }

    .exp-position {
      font-size: 11pt;
      font-weight: 700;
      color: {{colors.headings}};
      text-transform: uppercase;
    }

    .exp-company {
      font-size: 9pt;
      color: #666;
      font-style: italic;
    }

    .exp-desc {
      font-size: 9pt;
      color: {{colors.text}};
      margin-top: 10px;
      line-height: 1.6;
    }

    .exp-achievements {
      margin-top: 10px;
      padding-left: 15px;
    }

    .exp-achievements li {
      font-size: 9pt;
      color: {{colors.text}};
      margin-bottom: 5px;
    }

    .project-item {
      margin-bottom: 20px;
    }

    .project-name {
      font-size: 10pt;
      font-weight: 700;
      color: {{colors.headings}};
    }

    .project-url {
      font-size: 8pt;
      color: {{colors.primary}};
      margin-top: 3px;
    }

    .project-desc {
      font-size: 9pt;
      color: {{colors.text}};
      margin-top: 5px;
      line-height: 1.5;
    }

    .project-tech {
      font-size: 8pt;
      color: #666;
      margin-top: 5px;
    }

    .pub-item {
      margin-bottom: 15px;
    }

    .pub-title {
      font-size: 10pt;
      font-weight: 700;
      color: {{colors.headings}};
    }

    .pub-info {
      font-size: 8pt;
      color: #666;
      margin-top: 3px;
    }

    .pub-desc {
      font-size: 9pt;
      color: {{colors.text}};
      margin-top: 5px;
    }

    .award-item {
      margin-bottom: 15px;
    }

    .award-title {
      font-size: 10pt;
      font-weight: 700;
      color: {{colors.headings}};
    }

    .award-info {
      font-size: 8pt;
      color: #666;
      margin-top: 3px;
    }

    .award-desc {
      font-size: 9pt;
      color: {{colors.text}};
      margin-top: 5px;
    }

    .volunteer-item {
      margin-bottom: 20px;
    }

    .volunteer-role {
      font-size: 10pt;
      font-weight: 700;
      color: {{colors.headings}};
    }

    .volunteer-org {
      font-size: 9pt;
      color: #666;
      font-style: italic;
    }

    .volunteer-date {
      font-size: 8pt;
      color: {{colors.primary}};
      margin-top: 3px;
    }

    .volunteer-desc {
      font-size: 9pt;
      color: {{colors.text}};
      margin-top: 5px;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <div class="cv-container">
    <div class="sidebar">
      @if(personalInfo.photoUrl)
      <div class="photo-section">
        <img src="{{personalInfo.photoUrl}}" alt="Photo" class="photo">
      </div>
      @endif

      @if(summary)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Profile</h2>
        <p class="profile-text">{{summary}}</p>
      </div>
      @endif

      @if(objective)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Objective</h2>
        <p class="profile-text">{{objective}}</p>
      </div>
      @endif

      @if(education && education.length)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Education</h2>
        @each(edu in education)
        <div class="edu-item">
          <div class="edu-degree">{{edu.degree}}</div>
          <div class="edu-school">{{edu.institution}}</div>
          <div class="edu-date">{{edu.startDate}} - @if(edu.current)Present@else{{edu.endDate}}@endif</div>
        </div>
        @endeach
      </div>
      @endif

      @if(skills && skills.length)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Skills</h2>
        @each(skill in skills)
        <div class="skill-item">
          <div class="skill-name">{{skill.name}}</div>
          <div class="skill-bar">
            <div class="skill-progress" style="width: @if(skill.level === 'expert')100%@elseif(skill.level === 'advanced')80%@elseif(skill.level === 'intermediate')60%@else40%@endif"></div>
          </div>
        </div>
        @endeach
      </div>
      @endif

      @if(languages && languages.length)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Languages</h2>
        @each(lang in languages)
        <div class="language-item">
          <span>{{lang.name}}</span>
          <span>{{lang.proficiency}}</span>
        </div>
        @endeach
      </div>
      @endif

      @if(certifications && certifications.length)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Certifications</h2>
        @each(cert in certifications)
        <div class="cert-item">
          <div class="cert-name">{{cert.name}}</div>
          <div class="cert-info">{{cert.issuer}} - {{cert.issueDate}}</div>
        </div>
        @endeach
      </div>
      @endif

      @if(interests && interests.length)
      <div class="sidebar-section">
        <h2 class="sidebar-title">Interests</h2>
        @each(interest in interests)
        <div class="interest-item">{{interest.name}}</div>
        @endeach
      </div>
      @endif

      @if(references && references.length)
      <div class="sidebar-section">
        <h2 class="sidebar-title">References</h2>
        @each(ref in references)
        <div class="reference-item">
          <div class="reference-name">{{ref.name}}</div>
          <div class="reference-title">{{ref.title}}, {{ref.company}}</div>
          <div class="reference-contact">{{ref.email}}</div>
        </div>
        @endeach
      </div>
      @endif
    </div>

    <div class="main-content">
      <div class="header-bar">
        <h1 class="name">{{personalInfo.firstName}} {{personalInfo.lastName}}</h1>
        <div class="title">{{personalInfo.title}}</div>
        <div class="header-contact">
          @if(personalInfo.phone)
          <div class="header-contact-item">
            <span class="header-contact-icon">T</span>
            {{personalInfo.phone}}
          </div>
          @endif
          @if(personalInfo.email)
          <div class="header-contact-item">
            <span class="header-contact-icon">@</span>
            {{personalInfo.email}}
          </div>
          @endif
          @if(personalInfo.city)
          <div class="header-contact-item">
            <span class="header-contact-icon">A</span>
            {{personalInfo.city}}, {{personalInfo.country}}
          </div>
          @endif
        </div>
      </div>

      @if(experiences && experiences.length)
      <div class="main-section">
        <h2 class="main-title">Work Experience</h2>
        @each(exp in experiences)
        <div class="experience-item">
          <div class="exp-header">
            <div>
              <div class="exp-position">{{exp.jobTitle}}</div>
              <div class="exp-company">{{exp.company}}@if(exp.location), {{exp.location}}@endif</div>
            </div>
            <div class="exp-date">{{exp.startDate}} - @if(exp.current)Present@else{{exp.endDate}}@endif</div>
          </div>
          @if(exp.description)
          <p class="exp-desc">{{exp.description}}</p>
          @endif
          @if(exp.achievements && exp.achievements.length)
          <ul class="exp-achievements">
            @each(achievement in exp.achievements)
            <li>{{achievement}}</li>
            @endeach
          </ul>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(projects && projects.length)
      <div class="main-section">
        <h2 class="main-title">Projects</h2>
        @each(project in projects)
        <div class="project-item">
          <div class="project-name">{{project.name}}</div>
          @if(project.url)
          <div class="project-url">{{project.url}}</div>
          @endif
          @if(project.description)
          <p class="project-desc">{{project.description}}</p>
          @endif
          @if(project.technologies && project.technologies.length)
          <div class="project-tech">Technologies: {{project.technologies.join(', ')}}</div>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(publications && publications.length)
      <div class="main-section">
        <h2 class="main-title">Publications</h2>
        @each(pub in publications)
        <div class="pub-item">
          <div class="pub-title">{{pub.title}}</div>
          <div class="pub-info">{{pub.publisher}} - {{pub.publicationDate}}</div>
          @if(pub.description)
          <p class="pub-desc">{{pub.description}}</p>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(awards && awards.length)
      <div class="main-section">
        <h2 class="main-title">Awards</h2>
        @each(award in awards)
        <div class="award-item">
          <div class="award-title">{{award.title}}</div>
          <div class="award-info">{{award.issuer}} - {{award.date}}</div>
          @if(award.description)
          <p class="award-desc">{{award.description}}</p>
          @endif
        </div>
        @endeach
      </div>
      @endif

      @if(volunteer && volunteer.length)
      <div class="main-section">
        <h2 class="main-title">Volunteer Experience</h2>
        @each(vol in volunteer)
        <div class="volunteer-item">
          <div class="volunteer-role">{{vol.role}}</div>
          <div class="volunteer-org">{{vol.organization}}</div>
          <div class="volunteer-date">{{vol.startDate}} - @if(vol.current)Present@else{{vol.endDate}}@endif</div>
          @if(vol.description)
          <p class="volunteer-desc">{{vol.description}}</p>
          @endif
        </div>
        @endeach
      </div>
      @endif
    </div>
  </div>
</body>
</html>
